        "#| tbl-cap-location: top\n",
        "#| echo: false\n",
        "\n",
        "# Carregamento do XML e criação do GeoDataFrame\n",
        "try:\n",
        "    with open(f'{ref_bacen}_{produtor}.xml', 'r', encoding='utf-16be') as f:\n",
        "    #with open(f'{ref_bacen}_{produtor}.xml', 'r', encoding='utf-8') as f:\n",
        "        xml_content = f.read()\n",
        "except FileNotFoundError:\n",
        "    print_status(f\"ERRO: O arquivo {ref_bacen}_{produtor}.xml não foi encontrado.\")\n",
        "    xml_content = None\n",
        "except Exception as e:\n",
        "    print_status(f\"ERRO ao ler o arquivo XML: {e}\")\n",
        "    xml_content = None\n",
        "\n",
        "if xml_content:\n",
        "    try:\n",
        "        gdf = parse_xml_to_gdf_all_fields(xml_content)\n",
        "    except Exception as e:\n",
        "        print_status(f\"ERRO ao parsear o XML para GeoDataFrame: {e}\")\n",
        "        gdf = None\n",
        "else:\n",
        "    gdf = None\n",
        "\n",
        "# Verificação se o GDF foi criado\n",
        "if gdf is None or gdf.empty:\n",
        "    print_status(\"ERRO: GeoDataFrame não pôde ser criado ou está vazio. O relatório não pode continuar.\")\n",
        "    # Interrompe a execução do Quarto aqui, se possível (em um script normal, usaríamos sys.exit)\n",
        "    raise SystemExit(\"Parando a execução devido à falha no carregamento dos dados.\")"
      ],
