      "source": [
        "#| echo: false\n",
        "\n",
        "# 1. Obter a coluna 'Properties' (que contém strings JSON)\n",
        "properties_json_series = gdf['Properties']\n",
        "\n",
        "# 2. Parsear cada string JSON para uma lista de dicionários\n",
        "all_properties_list_of_lists = properties_json_series.apply(json.loads)\n",
        "\n",
        "# 3. Combinar todas as listas de propriedades em uma única lista\n",
        "combined_properties_list = []\n",
        "if not all_properties_list_of_lists.empty:\n",
        "    combined_properties_list = all_properties_list_of_lists.sum()\n",
        "\n",
        "# 4. Criar o DataFrame e remover duplicatas\n",
        "if combined_properties_list:\n",
        "    df = pd.DataFrame(combined_properties_list).drop_duplicates().reset_index(drop=True)\n",
        "    \n",
        "    # Reordenar colunas para uma ordem lógica e combinar col_widths\n",
        "    # As colunas são: TpPessoaPropt, CNPJBase_CPFPropt, NIRF, CodSNCR, NumRegCAR\n",
        "    df = df[['NIRF', 'CodSNCR', 'NumRegCAR']].drop_duplicates().reset_index(drop=True)\n",
        "    \n",
        "    # Ajustar col_widths para 5 colunas\n",
        "    plot_df_as_table(df, title=\"Imóveis Associados à Operação\", col_widths=[0.15, 0.25, 0.6])\n",
        "else:\n",
        "    display(Markdown(\"Nenhum imóvel associado encontrado.\"))"
