    {
      "cell_type": "code",
      "metadata": {
        "fig-width": 10
      },
      "source": [
        "#| echo: false\n",
        "\n",
        "# 1. Explodir o gdf UMA VEZ para ter uma linha por gleba (polígono individual)\n",
        "#    Mantendo os dados do empreendimento (row) associados a cada gleba\n",
        "# index_parts=True é importante se os MultiPolygons tiverem mais de uma parte\n",
        "exploded_gdf = gdf.explode(index_parts=True).reset_index()\n",
        "# 'index' será o índice original (0, 1, ... para cada empreendimento)\n",
        "exploded_gdf = exploded_gdf.rename(columns={'level_0': 'empreendimento_id', 'level_1': 'gleba_id'})\n",
        "\n",
        "\n",
        "# 2. Iterar por cada *EMPREENDIMENTO* (destino) original\n",
        "#    gdf.iterrows() itera sobre o DataFrame *antes* do explode\n",
        "for i, dest_row in gdf.iterrows():\n",
        "    \n",
        "    #display(Markdown(r\"\\newpage\"))\n",
        "\n",
        "    display(Markdown(f\"## Empreendimento {i+1}\"))\n",
        "\n",
        "    cols_to_exclude = ['geometry', 'Beneficiarios', 'Properties', 'Parcels', 'ZARC',\n",
        "    'IdentdEmissor', 'IdentdDestinatario', 'DomSist', 'NUOp', 'CodMsg', 'NumCtrlIF', 'CNPJEntRespons', 'DtEms', 'DtVenc', 'NumCedlCredRuralIF', 'TpInstntoCred', 'VlrTotOp', 'CodPorteBenfcrio', 'DtMovto', 'CodSistProdc', 'CD_TIPO_CULTURA',\n",
        "    'DATA_INICIO','DATA_FIM','VlrParclRecProprio', 'CEDULA_MAE', 'CodProg_LinhaCred', 'TpFnteRec', 'TpEncargoFinancCompltar', 'QtdPrvProdc', 'CodModSegr', 'VlrReceitaBrutEsprdEmpnmnt', 'VARIEDADE', 'ZONEAMENTO', 'UNIDADE_MEDIDA', 'UNIDADE_MEDIDA_PREVISAO','CONSORCIO'#, 'TpSolo'\n",
        "    ]\n",
        "    dest_series = dest_row.drop(labels=cols_to_exclude, errors='ignore')\n",
        "    dest_details_df = pd.DataFrame(dest_series).reset_index()\n",
        "    dest_details_df.columns = [\"Atributo\", \"Valor\"]\n",
        "    \n",
        "    plot_df_as_table(\n",
        "        dest_details_df, \n",
        "        col_widths=[0.4, 0.6], \n",
        "        is_kv_style=True,\n",
        "        fig_height_scale=0.35 # Reduz a altura por linha\n",
        "    )\n",
        "    \n",
        "    cod_emp = dest_row['CodEmpnmnt']\n",
        "\n",
        "    # Pega as glebas *deste* empreendimento no gdf explodido\n",
        "    # 'i' é o índice original da linha de 'dest_row'\n",
        "    gdf_empreendimento_glebas = exploded_gdf[exploded_gdf['empreendimento_id'] == i]\n",
        "    \n",
        "    if not gdf_empreendimento_glebas.empty:\n",
        "        property_aea_emp = gdf_empreendimento_glebas.to_crs(area_proj)\n",
        "        area_ha_emp = property_aea_emp.geometry.area.sum() / 10000\n",
        "    else:\n",
        "        area_ha_emp = 0\n",
        "\n",
        "    # Cultura específica (já está no dest_row do merge anterior)\n",
        "    cultura_emp = dest_row.get('PRODUTO', 'Não informado')\n",
        "    qtd_prod_emp = dest_row.get('QtdPrvProdc', 'N/A')\n",
        "\n",
        "    produtividade = float(qtd_prod_emp)*1000 / float(area_ha_emp) if area_ha_emp > 0 else 'N/A'\n",
        "    \n",
        "    # Cria a tabela de desvios\n",
        "    area_financiada_df_emp = pd.DataFrame([\n",
        "        [\"Área do cultivo (ha):\", \"\", f\"{area_ha_emp:,.2f}\", \"\"],\n",
        "        [\"Área outros cultivos (ha):\", \"\", \"-\", \"\"], # Valor parece estático no original\n",
        "        [\"Área sem cultivo (ha):\", \"\", \"-\", \"\"], # Valor parece estático no original\n",
        "        [\"Cultura:\", \"\", cultura_emp, \"\"], # Valor parece estático no original\n",
        "        [\"Desenv. Vegetativo Alcançado:\", \"\", \"-\", \"\"], # Valor parece estático no original\n",
        "        [\"Expectativa de produtividade (Kg/ha):\", \"\",f\"{float(produtividade):,.2f}\" , \"\"], # Valor parece estático no original\n",
        "        [\"Expectativa de produção (Kg):\", \"\", f\"{float(qtd_prod_emp)*1000:,.2f}\", \"\"]\n",
        "    ], columns=[\"Descrição\", \"Dados observados\", \"Dados informados\", \"Relevância\"])\n",
        "\n",
        "    plot_df_as_table(\n",
        "        area_financiada_df_emp,\n",
        "        title = f\"Análise dos Desvios Verificados para o Empreendimento {i+1}\",\n",
        "        col_widths=[0.45, 0.2, 0.25, 0.1],\n",
        "        fig_height_scale=0.55,\n",
        "        font_size=10,\n",
        "        bold_first_col=True\n",
        "    )\n",
        "\n",
        "    # Cria um bloco de texto para a conclusão, com espaço para escrita e linha de assinatura.\n",
        "    conclusion_text = f\"\"\"\n",
        "### Conclusão quanto a análise do empreendimento {i+1}:\n",
        "\n",
        ".\n",
        "\n",
        ".\n",
        "\n",
        ".\n",
        "\n",
        ".\n",
        "\n",
        ".\n",
        "\n",
        ".\n",
        "\n",
        "**Assinatura do Responsável pelo Laudo**\n",
        "\n",
        "---\n",
        "\n",
        "\"\"\"\n",
        "    display(Markdown(conclusion_text))\n",
        "\n",
        "    display(Markdown(r\"\\newpage\"))\n",
        "\n",
        "    # 3. Iterar sobre cada *GLEBA* (talhão) deste empreendimento\n",
        "    #    Itera sobre o dataframe *explodido* e filtrado\n",
        "    for _, gleba_row in gdf_empreendimento_glebas.iterrows():\n",
        "        \n",
        "        # 'gleba_id' foi criado no reset_index do explode\n",
        "        gleba_id = gleba_row['gleba_id']\n",
        "        \n",
        "        display(Markdown(f\"### Análise do Talhão ID: {gleba_id} (Empreendimento {i+1})\"))\n",
        "\n",
        "        # Chama a função principal, que cuida de tudo\n",
        "        # A função 'processar_gleba' não foi fornecida, mas a lógica de chamada está correta\n",
        "        processar_gleba(\n",
        "            gleba_row, \n",
        "            gleba_id,\n",
        "            map_fig = True,\n",
        "            wtss_fig = True,\n",
        "            sentinel_fig = False,\n",
        "            som_fig = False\n",
        "        )\n",
        "\n",
        "        display(Markdown(r\"\\newpage\"))\n",
        "\n",
        "        #break\n",
        "    #break\n"
      ],
      "id": "77e20b59",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "\\newpage\n",
        "\n",
        "## Metodologia (Atendimento à Resolução CMN Nº 5.267)\n",
        "\n",
        "Este relatório utiliza dados de sensoriamento remoto para análise e monitoramento das operações de crédito rural. Esta metodologia é aplicada obrigatoriamente para as operações de custeio e investimento em áreas iguais ou superiores a **300 hectares**, conforme a Resolução CMN Nº 5.267. Combinamos diferentes fontes e técnicas para gerar informações precisas e robustas sobre as propriedades financiadas, atendendo aos requisitos de fiscalização do Banco Central (BACEN).\n",
        "\n",
        "### Fontes de Dados de Sensoriamento Remoto\n",
        "\n",
        "As fontes de dados foram selecionadas com base na qualidade e na necessidade de atender às resoluções **espacial, temporal, espectral e radiométrica** adequadas, conforme exigido.\n",
        "\n",
        "- **MODIS (Moderate Resolution Imaging Spectroradiometer)**\n",
        "  * **Resolução Espacial:** 250 metros.\n",
        "  * **Resolução Radiométrica:** 12 bits.\n",
        "  * **Utilização:** Geração de séries temporais longas (até 6 anos) do índice NDVI, permitindo a análise de tendências fenológicas e detecção de variações ao longo de amplos períodos. A série temporal é suavizada para reduzir ruídos atmosféricos e de cobertura.\n",
        "  * **Bandas Espectrais:** Infravermelho Próximo (NIR) e Vermelho (Red).\n",
        "\n",
        "- **Sentinel-2 (Missão Copernicus)**\n",
        "  * **Resolução Espacial:** 10 metros (nas bandas visíveis e NIR).\n",
        "  * **Resolução Radiométrica:** 12 bits.\n",
        "  * **Utilização:** Geração de composições de imagens RGB e cálculo do índice EVI (Enhanced Vegetation Index) com alta resolução espacial. As imagens são processadas em mosaicos mensais com aplicação rigorosa de máscara de nuvens, garantindo a qualidade e cobertura do dado.\n",
        "  * **Bandas Espectrais:**\n",
        "      * **RGB:** Bandas 4 (Red), 3 (Green) e 2 (Blue).\n",
        "      * **EVI:** Bandas 8 (NIR), 4 (Red) e 2 (Blue).\n",
        "\n",
        "### Índices de Vegetação e Monitoramento\n",
        "\n",
        "- **NDVI (Normalized Difference Vegetation Index)**\n",
        "  * Utilizado para análise fenológica a partir das séries temporais MODIS, detectando variações de saúde e vigor da vegetação em escala regional.\n",
        "\n",
        "- **EVI (Enhanced Vegetation Index)**\n",
        "  * Utilizado nas composições mensais de alta resolução (Sentinel-2) para análise detalhada da condição da vegetação nas glebas, sendo mais sensível em áreas de alta biomassa.\n",
        "\n",
        "### Verificação de Conformidade e Procedimentos (MCR e Resolução 5.267)\n",
        "\n",
        "O monitoramento remoto integra as análises técnicas com os requisitos regulatórios, verificando o uso adequado dos recursos e o cumprimento das normas ambientais.\n",
        "\n",
        "#### 1. Verificação de Área e Compatibilidade da Cultura\n",
        "\n",
        "* **Monitoramento da Área Emergida (MCR 2-1-3):** A alta resolução do Sentinel-2 permite o cálculo e monitoramento da **área efetivamente cultivada**, comparando-a com a área prevista na operação de crédito.\n",
        "* **Validação da Cultura:** O **Modelo de Clusterização SOM** é treinado com as séries temporais de EVI/NDVI. A análise dos **perfis temporais médios por cluster** é utilizada para **validar a fenologia da cultura financiada**, confirmando a compatibilidade da atividade em campo com o projeto aprovado.\n",
        "\n",
        "#### 2. Conformidade Ambiental (MCR 2-9-5 a 16)\n",
        "\n",
        "* **Detecção de Desvio de Uso da Terra:** A combinação da série temporal de longo prazo (MODIS) com a alta resolução detalhada (Sentinel-2) é utilizada para **identificar o desmatamento ilegal ou alterações indevidas** no uso do solo.\n",
        "* **Monitoramento de Áreas Vedadas:** A metodologia permite **monitorar a manutenção da vegetação nativa e das áreas de preservação**, comparando as alterações detectadas com bases oficiais de embargos, garantindo o atendimento às regras de elegibilidade ambiental do crédito rural.\n",
        "\n",
        "### Modelo de Clusterização (Self-Organizing Maps - SOM)\n",
        "\n",
        "Para identificar padrões espaciais e temporais na dinâmica da vegetação, é aplicada a técnica **Self-Organizing Maps (SOM)**, que organiza dados multidimensionais em uma grade bidimensional, preservando a topologia.\n",
        "\n",
        "* O SOM é treinado com as séries temporais de EVI extraídas das imagens Sentinel-2, considerando apenas pixels válidos (após aplicação de máscara de nuvens e recorte espacial).\n",
        "* A clusterização agrupa áreas com comportamentos fenológicos semelhantes, facilitando a identificação de diferentes perfis de desenvolvimento vegetativo dentro das glebas para validação da cultura e detecção de anomalias.\n",
        "\n",
        "Esta abordagem integrada possibilita uma avaliação robusta e detalhada das condições das propriedades rurais, em total conformidade com as diretrizes do Banco Central para fiscalização e monitoramento.\n",
        "\n",
        "## Glossário de Termos\n",
        "\n",
        "* **MODIS (Moderate Resolution Imaging Spectroradiometer)**: Sensor de satélite que fornece imagens com resolução espacial moderada e alta frequência temporal, utilizado para monitoramento ambiental em larga escala.\n",
        "* **Sentinel-2**: Satélite do programa Copernicus que fornece imagens ópticas de alta resolução espacial, utilizadas para análise detalhada da cobertura vegetal.\n",
        "* **NDVI (Normalized Difference Vegetation Index)**: Índice de vegetação que mede a saúde e vigor da vegetação com base na reflectância do vermelho e do infravermelho próximo.\n",
        "* **EVI (Enhanced Vegetation Index)**: Índice de vegetação que melhora a sensibilidade em áreas com alta biomassa e reduz interferências atmosféricas.\n",
        "* **Self-Organizing Map (SOM)**: Técnica de aprendizado não supervisionado que organiza dados multidimensionais em uma grade bidimensional, preservando relações topológicas para facilitar a clusterização.\n",
        "* **Clusterização**: Processo de agrupar dados com características semelhantes para identificar padrões ou categorias.\n",
        "* **Máscara de nuvens**: Técnica aplicada em imagens de satélite para identificar e excluir pixels cobertos por nuvens, garantindo a qualidade dos dados analisados.\n",
        "* **Gleba**: Unidade territorial delimitada dentro de uma propriedade rural, geralmente um talhão ou parcela agrícola.\n",
        "* **Série temporal**: Conjunto de dados coletados sequencialmente ao longo do tempo, utilizado para análise de tendências e padrões.\n",
        "* **Resolução espacial**: Tamanho do menor objeto que pode ser detectado em uma imagem de satélite, geralmente medido em metros.\n",
        "* **Resolução temporal**: Frequência com que imagens ou dados são coletados para uma mesma área.\n",
        "\n",
        "\\newpage\n",
        "\n",
        "\n",
        "## Anexos"
      ],
