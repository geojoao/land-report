      "source": [
        "#| echo: false\n",
        "\n",
        "# Carregar o CSV de empreendimentos\n",
        "codempreendimento_df = pd.read_csv('https://www.bcb.gov.br/htms/sicor/Empreendimento.csv', encoding='windows-1252')\n",
        "\n",
        "# Renomear a coluna no CSV para corresponder ao gdf\n",
        "codempreendimento_df = codempreendimento_df.rename(columns={'#CODIGO':'CodEmpnmnt'})\n",
        "\n",
        "# Garantir que a chave de junção seja string em ambos\n",
        "codempreendimento_df['CodEmpnmnt'] = codempreendimento_df['CodEmpnmnt'].astype(str)\n",
        "gdf['CodEmpnmnt'] = gdf['CodEmpnmnt'].astype(str)\n",
        "\n",
        "# Fazer o merge no gdf para adicionar 'PRODUTO' e outras infos\n",
        "# Isso adiciona as colunas do CSV (como 'PRODUTO') ao nosso gdf\n",
        "gdf = gdf.merge(codempreendimento_df, how='left', on='CodEmpnmnt')\n",
        "\n",
        "# Carregar o CSV de tipos de solo\n",
        "tiposolo_df = pd.read_csv('https://www.bcb.gov.br/htms/sicor/TipoSoloProagro.csv', encoding='windows-1252', sep=';')\n",
        "tiposolo_df = tiposolo_df.rename(columns={'#CODIGO_TIPO_SOLO': 'TpSolo', '#DESCRICAO_TIPO_SOLO': 'DescricaoSolo'})\n",
        "\n",
        "# Extrair 'TpSolo' do JSON 'ZARC' e fazer o merge\n",
        "gdf['TpSolo'] = gdf['ZARC'].apply(lambda x: json.loads(x)[0].get('TpSolo') if x and x != '[]' else None)\n",
        "gdf['TpSolo'] = pd.to_numeric(gdf['TpSolo'], errors='coerce')\n",
        "gdf = gdf.merge(tiposolo_df, how='left', on='TpSolo')\n",
        "\n",
        "# Carrega apenas o município que cruza com a gleba, economizando memória.\n",
        "municipio_filtrado = load_ibge_municipalities(bbox=tuple(gdf.total_bounds))\n",
        "joined = gpd.sjoin(gdf, municipio_filtrado, how=\"left\", predicate=\"intersects\")\n",
        "joined[\"city\"] = joined[\"NM_MUN\"]\n",
        "joined[\"state\"] = joined[\"NM_UF\"]\n",
        "\n",
        "fig_localization = plot_rural_property(joined, municipalities_gdf=municipio_filtrado)\n",
        "plt.show()\n"
      ],
      "id": "90e223e0",
      "execution_count": null,
      "outputs": []
