      "source": [
        "#| tbl-cap: \"Resumo Geral da Operação de Crédito\"\n",
        "#| echo: false\n",
        "\n",
        "# Projeção e cálculo de área\n",
        "area_proj = \"+proj=aea +lat_0=-12 +lon_0=-54 +lat_1=-2 +lat_2=-22 +x_0=5000000 +y_0=10000000 +ellps=GRS80 +units=m +no_defs\"\n",
        "property_aea = gdf.to_crs(area_proj)\n",
        "area_ha = property_aea[['geometry']].dissolve().geometry.area.sum() / 10000\n",
        "\n",
        "# Extrair CNPJ/CPF do primeiro beneficiário do JSON\n",
        "cnpj_cpf = \"N/A\"\n",
        "if 'Beneficiarios' in gdf.columns:\n",
        "    try:\n",
        "        beneficiarios_list = json.loads(gdf['Beneficiarios'].iloc[0])\n",
        "        if beneficiarios_list:\n",
        "            cnpj_cpf = beneficiarios_list[0].get('CNPJ_CPFBenfcrio', 'N/A')\n",
        "    except (json.JSONDecodeError, IndexError):\n",
        "        cnpj_cpf = \"Erro ao ler JSON de Beneficiários\"\n",
        "\n",
        "# Dados cadastrais\n",
        "dados_cadastrais = {\n",
        "    'Instituição Financeira:': 'BOCOM BBM',\n",
        "    'Produtor:': produtor,\n",
        "    'CPF / CNPJ:': cnpj_cpf,\n",
        "    'REFBACEN:': ref_bacen,\n",
        "    'Área Financiada (ha):': f\"{area_ha:,.2f}\",\n",
        "    'Receita esperada (BRL):': f\"{gdf['VlrReceitaBrutEsprdEmpnmnt'].astype(float).sum():,.2f}\"\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(list(dados_cadastrais.items()), columns=['Atributo', 'Valor'])\n",
        "\n",
        "plot_df_as_table(df, col_widths=[0.4, 0.6], is_kv_style=True)"
      ],
