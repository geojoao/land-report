      "source": [
        "#| include: false\n",
        "\n",
        "import os\n",
        "import sys\n",
        "import math\n",
        "import geopandas as gpd\n",
        "import requests\n",
        "import time\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib\n",
        "import contextily as ctx\n",
        " \n",
        "import matplotlib.patches as mpatches\n",
        "import matplotlib.image as mpimg\n",
        "from datetime import datetime\n",
        "from dateutil.relativedelta import relativedelta\n",
        "\n",
        " \n",
        "from sqlalchemy import create_engine\n",
        " \n",
        "from pystac_client import Client\n",
        "import pystac_client\n",
        "import shapely\n",
        " \n",
        "import wtss\n",
        "from shapely.geometry import Polygon, Point\n",
        "import random\n",
        "from wcpms import *\n",
        "from scipy.signal import savgol_filter\n",
        " \n",
        "from skimage.transform import resize\n",
        " \n",
        "from matplotlib.backends.backend_pdf import PdfPages\n",
        "import kaleido\n",
        " \n",
        "import xml.etree.ElementTree as ET\n",
        "import geopandas as gpd\n",
        "from shapely.geometry import Polygon, MultiPolygon\n",
        " \n",
        "import requests, zipfile, io\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from minisom import MiniSom\n",
        "\n",
        "import pystac_client, rioxarray, xarray as xr, dask.diagnostics\n",
        "from odc.stac import stac_load\n",
        "import dask\n",
        "from rasterio.warp import reproject, Resampling\n",
        "from shapely.geometry import mapping\n",
        "from rasterio.io import MemoryFile\n",
        "from rasterio.merge import merge\n",
        "\n",
        "from collections import defaultdict\n",
        "\n",
        "import warnings\n",
        "warnings.simplefilter(action='ignore', category=FutureWarning)\n",
        " \n",
        "def print_status(message):\n",
        "    \"\"\"Prints a message to stderr to show in the console but not in the report.\"\"\"\n",
        "    print(message, file=sys.stderr, flush=True)\n",
        " \n",
        "def dataframe_to_markdown(df, show_index=True):\n",
        "    \"\"\"\n",
        "    Converts a pandas DataFrame to a markdown table string without\n",
        "    requiring the 'tabulate' library.\n",
        "    \"\"\"\n",
        "    header = \"|\"\n",
        "    separator = \"|\"\n",
        "    if show_index:\n",
        "        header += f\" {df.index.name or ''} |\"\n",
        "        separator += \" --- |\"\n",
        "    header += \" | \".join(df.columns) + \" |\"\n",
        "    separator += \" --- |\" * len(df.columns)\n",
        "   \n",
        "    body = \"\\n\".join([f\"| {(f'{i} | ' if show_index else '')}{' | '.join(map(str, row))} |\" for i, row in df.iterrows()])\n",
        "    return f\"{header}\\n{separator}\\n{body}\"\n",
        " \n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "from IPython.display import display, Markdown\n",
        "import json\n",
        "\n",
        "def plot_df_as_table(df, title=\"\", col_widths=None, is_kv_style=False, fig_height_scale=0.5, font_size=10, zebra_stripe=True, bold_first_col=False):\n",
        "    \"\"\"\n",
        "    Gera uma imagem de tabela estilizada a partir de um DataFrame usando matplotlib.\n",
        "    \"\"\"\n",
        "    plot_df = df.copy()\n",
        "    cell_text = plot_df.values.tolist()\n",
        "    col_labels = plot_df.columns.tolist()\n",
        "    num_cols = len(col_labels)\n",
        "\n",
        "    num_rows = len(cell_text)\n",
        "    fig_height = max(1, num_rows * fig_height_scale)\n",
        "    \n",
        "    fig, ax = plt.subplots(figsize=(8, fig_height))\n",
        "    ax.axis('off')\n",
        "    if title:\n",
        "        ax.set_title(title, fontweight=\"bold\", loc='left', pad=10)\n",
        "\n",
        "    table = ax.table(\n",
        "        cellText=cell_text,\n",
        "        colLabels=col_labels,\n",
        "        cellLoc='left',\n",
        "        loc='center',\n",
        "        colWidths=col_widths\n",
        "    )\n",
        "    \n",
        "    table.auto_set_font_size(False)\n",
        "    table.set_fontsize(font_size)\n",
        "    table.scale(1, 1.8)\n",
        "\n",
        "    # Estiliza o cabeçalho\n",
        "    for (i, j), cell in table.get_celld().items():\n",
        "        if i == 0:\n",
        "            cell.get_text().set_weight('bold')\n",
        "            cell.set_facecolor('#e0e0e0')\n",
        "        cell.set_edgecolor('#dddddd')\n",
        "\n",
        "    # Estilo de linhas zebradas\n",
        "    if zebra_stripe:\n",
        "        for i in range(num_rows):\n",
        "            bg_color = '#f9f9f9' if i % 2 == 0 else '#ffffff'\n",
        "            for j in range(num_cols):\n",
        "                table[(i + 1, j)].set_facecolor(bg_color)\n",
        "\n",
        "    # Estilo chave-valor (primeira coluna em negrito)\n",
        "    if is_kv_style or bold_first_col:\n",
        "        for i in range(num_rows):\n",
        "            table[(i + 1, 0)].get_text().set_weight('bold')\n",
        "            # O estilo is_kv_style original só coloria as duas primeiras colunas\n",
        "            if is_kv_style and not zebra_stripe:\n",
        "                bg_color = '#f9f9f9' if i % 2 == 0 else '#ffffff'\n",
        "                table[(i + 1, 0)].set_facecolor(bg_color)\n",
        "                table[(i + 1, 1)].set_facecolor(bg_color)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "import xml.etree.ElementTree as ET\n",
        "import geopandas as gpd\n",
        "from shapely.geometry import Polygon, MultiPolygon\n",
        "import json\n",
        "\n",
        "def _find_text(element, path, ns, default=\"N/A\"):\n",
        "    \"\"\"\n",
        "    Helper function to find text in an XML element.\n",
        "    Returns 'default' (N/A) if not found.\n",
        "    \"\"\"\n",
        "    if element is None:\n",
        "        return default\n",
        "    node = element.find(path, ns)\n",
        "    return node.text.strip() if node is not None and node.text else default\n",
        "\n",
        "def parse_xml_to_gdf_all_fields(xml_string):\n",
        "    \"\"\"\n",
        "    Parses a COR0001 XML string to extract all general, destination, \n",
        "    property, and geometry data into a single GeoDataFrame.\n",
        "    \n",
        "    Each row represents one 'Grupo_COR0001_DestcFincmnt' (financing destination).\n",
        "    Nested repeating groups (Beneficiaries, Properties, Parcels, ZARC) \n",
        "    are stored as JSON strings.\n",
        "    \"\"\"\n",
        "    ns = {'ns': 'http://www.bcb.gov.br/MES/COR0001.xsd'}\n",
        "    root = ET.fromstring(xml_string)\n",
        "    \n",
        "    # 1. Find key elements\n",
        "    bcmsg_element = root.find('.//ns:BCMSG', ns)\n",
        "    cor_element = root.find('.//ns:COR0001', ns)\n",
        "    \n",
        "    if cor_element is None:\n",
        "        raise ValueError(\"Elemento COR0001 não encontrado no XML.\")\n",
        "\n",
        "    # 2. Extract General (Surface) Info - This will be repeated for all rows\n",
        "    general_info = {\n",
        "        # BCMSG Fields\n",
        "        \"IdentdEmissor\": _find_text(bcmsg_element, 'ns:IdentdEmissor', ns),\n",
        "        \"IdentdDestinatario\": _find_text(bcmsg_element, 'ns:IdentdDestinatario', ns),\n",
        "        \"DomSist\": _find_text(bcmsg_element, 'ns:DomSist', ns),\n",
        "        \"NUOp\": _find_text(bcmsg_element, 'ns:NUOp', ns),\n",
        "        \n",
        "        # COR0001 Top-Level Fields\n",
        "        \"CodMsg\": _find_text(cor_element, 'ns:CodMsg', ns),\n",
        "        \"NumCtrlIF\": _find_text(cor_element, 'ns:NumCtrlIF', ns),\n",
        "        \"CNPJEntRespons\": _find_text(cor_element, 'ns:CNPJEntRespons', ns),\n",
        "        \"DtEms\": _find_text(cor_element, 'ns:DtEms', ns),\n",
        "        \"DtVenc\": _find_text(cor_element, 'ns:DtVenc', ns),\n",
        "        \"NumCedlCredRuralIF\": _find_text(cor_element, 'ns:NumCedlCredRuralIF', ns),\n",
        "        \"TpInstntoCred\": _find_text(cor_element, 'ns:TpInstntoCred', ns),\n",
        "        \"VlrTotOp\": _find_text(cor_element, 'ns:VlrTotOp', ns),\n",
        "        \"CodPorteBenfcrio\": _find_text(cor_element, 'ns:CodPorteBenfcrio', ns),\n",
        "        \"DtMovto\": _find_text(cor_element, 'ns:DtMovto', ns),\n",
        "    }\n",
        "\n",
        "    # 3. Extract Operation-Wide Lists (e.g., Beneficiaries) as JSON\n",
        "    beneficiaries = []\n",
        "    for benf_elem in cor_element.findall('ns:Grupo_COR0001_Benfcrio', ns):\n",
        "        benf_data = {\n",
        "            \"TpPessoaBenfcrio\": _find_text(benf_elem, 'ns:TpPessoaBenfcrio', ns),\n",
        "            \"CNPJ_CPFBenfcrio\": _find_text(benf_elem, 'ns:CNPJ_CPFBenfcrio', ns),\n",
        "            \"TpBenfcrioCOR\": _find_text(benf_elem, 'ns:TpBenfcrioCOR', ns),\n",
        "        }\n",
        "        beneficiaries.append(benf_data)\n",
        "    general_info['Beneficiarios'] = json.dumps(beneficiaries)\n",
        "\n",
        "    # 4. Prepare list to hold rows for GeoDataFrame\n",
        "    rows = []\n",
        "    \n",
        "    # 5. Iterate over all Destinations (the \"deep level\" data)\n",
        "    for dest_elem in cor_element.findall('ns:Grupo_COR0001_DestcFincmnt', ns):\n",
        "        # Start a new row with the general (surface) info\n",
        "        row = general_info.copy()\n",
        "\n",
        "        # 6. Extract specific Destination Info (Single Fields)\n",
        "        dest_info = {\n",
        "            \"CodProg_LinhaCred\": _find_text(dest_elem, 'ns:CodProg_LinhaCred', ns),\n",
        "            \"TpFnteRec\": _find_text(dest_elem, 'ns:TpFnteRec', ns),\n",
        "            \"CodEmpnmnt\": _find_text(dest_elem, 'ns:CodEmpnmnt', ns),\n",
        "            \"CodSistProdc\": _find_text(dest_elem, 'ns:CodSistProdc', ns),\n",
        "            \"VlrParclCred\": _find_text(dest_elem, 'ns:VlrParclCred', ns),\n",
        "            \"VlrParclRecProprio\": _find_text(dest_elem, 'ns:VlrParclRecProprio', ns),\n",
        "            \"PercJurosEncargoFinanc\": _find_text(dest_elem, 'ns:PercJurosEncargoFinanc', ns),\n",
        "            \"TpEncargoFinancCompltar\": _find_text(dest_elem, 'ns:TpEncargoFinancCompltar', ns),\n",
        "            \"QtdPrvProdc\": _find_text(dest_elem, 'ns:QtdPrvProdc', ns),\n",
        "            \"CodModSegr\": _find_text(dest_elem, 'ns:CodModSegr', ns),\n",
        "            \"VlrReceitaBrutEsprdEmpnmnt\": _find_text(dest_elem, 'ns:VlrReceitaBrutEsprdEmpnmnt', ns),\n",
        "            \"DtIniPlant\": _find_text(dest_elem, 'ns:DtIniPlant', ns),\n",
        "            \"DtFimPlant\": _find_text(dest_elem, 'ns:DtFimPlant', ns),\n",
        "            \"DtIniColht\": _find_text(dest_elem, 'ns:DtIniColht', ns),\n",
        "            \"DtFimColht\": _find_text(dest_elem, 'ns:DtFimColht', ns),\n",
        "        }\n",
        "        row.update(dest_info)\n",
        "\n",
        "        # 7. Extract Destination-Specific Lists (as JSON)\n",
        "        \n",
        "        # Properties\n",
        "        properties = []\n",
        "        for prop_elem in dest_elem.findall('ns:Grupo_COR0001_Propt', ns):\n",
        "            prop_details = {\n",
        "                \"TpPessoaPropt\": _find_text(prop_elem, 'ns:TpPessoaPropt', ns),\n",
        "                \"CNPJBase_CPFPropt\": _find_text(prop_elem, 'ns:CNPJBase_CPFPropt', ns),\n",
        "                \"NIRF\": _find_text(prop_elem, 'ns:NIRF', ns),\n",
        "                \"CodSNCR\": _find_text(prop_elem, 'ns:CodSNCR', ns),\n",
        "                \"NumRegCAR\": _find_text(prop_elem, 'ns:NumRegCAR', ns),\n",
        "            }\n",
        "            properties.append(prop_details)\n",
        "        row['Properties'] = json.dumps(properties) if properties else \"[]\"\n",
        "        \n",
        "        # Parcels (Payment Installments)\n",
        "        parcels = []\n",
        "        for parcl_elem in dest_elem.findall('ns:Grupo_COR0001_Parcl', ns):\n",
        "            parcl_details = {\n",
        "                \"NumParcl\": _find_text(parcl_elem, 'ns:NumParcl', ns),\n",
        "                \"DtPrvPgto\": _find_text(parcl_elem, 'ns:DtPrvPgto', ns),\n",
        "                \"VlrPrincipalParcl\": _find_text(parcl_elem, 'ns:VlrPrincipalParcl', ns),\n",
        "            }\n",
        "            parcels.append(parcl_details)\n",
        "        row['Parcels'] = json.dumps(parcels) if parcels else \"[]\"\n",
        "\n",
        "        # ZARC\n",
        "        zarc_list = []\n",
        "        for zarc_elem in dest_elem.findall('ns:Grupo_COR0001_ZARC', ns):\n",
        "            zarc_details = {\n",
        "                \"CodCicloCultr\": _find_text(zarc_elem, 'ns:CodCicloCultr', ns),\n",
        "                \"TpSolo\": _find_text(zarc_elem, 'ns:TpSolo', ns),\n",
        "                \"TpManj\": _find_text(zarc_elem, 'ns:TpManj', ns),\n",
        "            }\n",
        "            zarc_list.append(zarc_details)\n",
        "        row['ZARC'] = json.dumps(zarc_list) if zarc_list else \"[]\"\n",
        "\n",
        "        # 8. Extract associated Geometries (Glebas)\n",
        "        polygons = []\n",
        "        for gleba in dest_elem.findall('ns:Grupo_COR0001_Gleba', ns):\n",
        "            polygon_points = []\n",
        "            # We can also extract IdentcGleba if needed, \n",
        "            # but it's not added to the row for now.\n",
        "            # identc_gleba = _find_text(gleba, 'ns:IdentcGleba', ns)\n",
        "            \n",
        "            for pt in gleba.findall('ns:Grupo_COR0001_PontoPolg', ns):\n",
        "                lat_node = pt.find('ns:LatPonto', ns)\n",
        "                lon_node = pt.find('ns:LongPonto', ns)\n",
        "                if lat_node is not None and lon_node is not None:\n",
        "                    try:\n",
        "                        lat_f = float(lat_node.text.strip())\n",
        "                        lon_f = float(lon_node.text.strip())\n",
        "                        polygon_points.append((lon_f, lat_f))\n",
        "                    except (ValueError, TypeError):\n",
        "                        pass # Skip invalid points\n",
        "            \n",
        "            if len(polygon_points) > 2: # Need at least 3 points for a polygon\n",
        "                # Close polygon if not closed\n",
        "                if polygon_points[0] != polygon_points[-1]:\n",
        "                    polygon_points.append(polygon_points[0])\n",
        "                polygons.append(Polygon(polygon_points))\n",
        "        \n",
        "        # If no valid polygons were found for this destination, skip it\n",
        "        if not polygons:\n",
        "            continue\n",
        "            \n",
        "        # Combine polygons into a MultiPolygon if more than one\n",
        "        if len(polygons) == 1:\n",
        "            row['geometry'] = polygons[0]\n",
        "        else:\n",
        "            row['geometry'] = MultiPolygon(polygons)\n",
        "        \n",
        "        # Add the completed row\n",
        "        rows.append(row)\n",
        "    \n",
        "    # 9. Create final GeoDataFrame\n",
        "    if not rows:\n",
        "        # Return an empty GeoDataFrame with expected columns if no data found\n",
        "        columns = list(general_info.keys())\n",
        "        columns.extend([\n",
        "            \"CodProg_LinhaCred\", \"TpFnteRec\", \"CodEmpnmnt\", \"CodSistProdc\", \n",
        "            \"VlrParclCred\", \"VlrParclRecProprio\", \"PercJurosEncargoFinanc\", \n",
        "            \"TpEncargoFinancCompltar\", \"QtdPrvProdc\", \"CodModSegr\", \n",
        "            \"VlrReceitaBrutEsprdEmpnmnt\", \"DtIniPlant\", \"DtFimPlant\", \n",
        "            \"DtIniColht\", \"DtFimColht\", \"Properties\", \"Parcels\", \"ZARC\", \n",
        "            \"geometry\"\n",
        "        ])\n",
        "        return gpd.GeoDataFrame([], columns=columns, crs=\"EPSG:4326\")\n",
        "    \n",
        "    gdf = gpd.GeoDataFrame(rows, crs=\"EPSG:4326\")\n",
        "    return gdf\n",
        " \n",
        "def retry_request(func, max_retries=8, delay=5, name=\"operação de rede\", **kwargs):\n",
        "    \"\"\"\n",
        "    Tenta executar uma função que faz uma requisição de rede, com retries.\n",
        "    \"\"\"\n",
        "    for attempt in range(max_retries):\n",
        "        try:\n",
        "            result = func(**kwargs)\n",
        "            return result, None  # Success\n",
        "        except (requests.exceptions.RequestException, pystac_client.exceptions.APIError, Exception) as e:\n",
        "            # Filter for common network errors\n",
        "            if any(err in str(e).lower() for err in ['timeout', 'connection', 'http', 'curl', 'network']):\n",
        "                print_status(f\"AVISO: Erro de rede na {name} (tentativa {attempt + 1}/{max_retries}): {e}\")\n",
        "                if attempt + 1 < max_retries:\n",
        "                    print_status(f\"Tentando novamente em {delay} segundos...\")\n",
        "                    time.sleep(delay)\n",
        "                else:\n",
        "                    error_msg = f\"Falha na {name} após {max_retries} tentativas. Último erro: {e}\"\n",
        "                    print_status(f\"ERRO: {error_msg}\")\n",
        "                    return None, error_msg\n",
        "            else:\n",
        "                # If it's a different error, fail immediately\n",
        "                error_msg = f\"Erro inesperado e não relacionado à rede na {name}: {e}\"\n",
        "                print_status(f\"ERRO: {error_msg}\")\n",
        "                return None, error_msg\n",
        "    return None, f\"Falha desconhecida na {name} após {max_retries} tentativas.\"\n",
        "\n",
        "try:\n",
        "    from matplotlib_scalebar.scalebar import ScaleBar\n",
        "except ImportError:\n",
        "    ScaleBar = None\n",
        " \n",
        "def load_ibge_municipalities(bbox=None):\n",
        "    \"\"\"\n",
        "    Downloads (if not cached), extracts, and loads IBGE municipalities.\n",
        "    Caches the file in /tmp to avoid repeated downloads.\n",
        "    \"\"\"\n",
        "    url = \"https://geoftp.ibge.gov.br/organizacao_do_territorio/malhas_territoriais/malhas_municipais/municipio_2024/Brasil/BR_Municipios_2024.zip\"\n",
        "    local_path = \"/tmp/BR_Municipios_2024.zip\"\n",
        "\n",
        "    # 1. Check if file exists locally\n",
        "    if not os.path.exists(local_path):\n",
        "        print_status(f\"File not found in {local_path}. Downloading from IBGE...\")\n",
        "        \n",
        "        response, error = retry_request(\n",
        "            func=requests.get,\n",
        "            name=\"download de municípios do IBGE\",\n",
        "            url=url,\n",
        "            stream=True\n",
        "        )\n",
        "\n",
        "        if error:\n",
        "            # Clean up partial file if download fails\n",
        "            if os.path.exists(local_path):\n",
        "                os.remove(local_path)\n",
        "            raise RuntimeError(error)\n",
        "\n",
        "        try:\n",
        "            response.raise_for_status() # Check for HTTP errors\n",
        "            \n",
        "            # Write file in chunks to avoid memory issues with large files\n",
        "            with open(local_path, 'wb') as f:\n",
        "                for chunk in response.iter_content(chunk_size=8192):\n",
        "                    f.write(chunk)\n",
        "            print_status(\"Download complete.\")\n",
        "            \n",
        "        except Exception as e:\n",
        "            # Clean up partial file if download fails\n",
        "            if os.path.exists(local_path):\n",
        "                os.remove(local_path)\n",
        "            raise e\n",
        "    else:\n",
        "        #print(f\"Loading cached file from {local_path}...\")\n",
        "        pass\n",
        "\n",
        "    # 2. Construct URI for the LOCAL zip file\n",
        "    # Note: 'zip://' is used for local files, 'zip+https://' is for remote\n",
        "    uri = f\"zip://{local_path}!BR_Municipios_2024.shp\"\n",
        "\n",
        "    # 3. Load with GeoPandas\n",
        "    gdf = gpd.read_file(uri, bbox=bbox)\n",
        "    gdf = gdf.to_crs(\"EPSG:4326\")\n",
        "    \n",
        "    return gdf\n",
        " \n",
        "\n",
        "def load_ibge_states():\n",
        "    url = \"https://geoftp.ibge.gov.br/organizacao_do_territorio/malhas_territoriais/malhas_municipais/municipio_2024/Brasil/BR_UF_2024.zip\"\n",
        "    \n",
        "    response, error = retry_request(\n",
        "        func=requests.get,\n",
        "        name=\"download de estados do IBGE\",\n",
        "        url=url\n",
        "    )\n",
        "\n",
        "    if error:\n",
        "        raise RuntimeError(error)\n",
        "\n",
        "    z = zipfile.ZipFile(io.BytesIO(response.content))\n",
        "    shp_path = [f for f in z.namelist() if f.endswith(\".shp\") and 'UF' in f][0]\n",
        "    z.extractall(\"ibge_states\")\n",
        "    gdf = gpd.read_file(f\"ibge_states/{shp_path}\")\n",
        "    gdf = gdf.to_crs(\"EPSG:4326\")\n",
        "    return gdf\n",
        " \n",
        "def plot_rural_property(property_gdf, municipalities_gdf=None):\n",
        "    centroid = property_gdf.geometry.centroid.iloc[0]\n",
        "    lon, lat = centroid.x, centroid.y\n",
        "    fig = plt.figure(figsize=(12, 8))\n",
        "    ax_main = fig.add_axes([0.05, 0.05, 0.65, 0.9])\n",
        "    property_proj = property_gdf.to_crs(epsg=3857)\n",
        "    minx, miny, maxx, maxy = property_proj.total_bounds\n",
        "    center_x, center_y = (minx + maxx) / 2, (miny + maxy) / 2\n",
        "    max_dim = max(maxx - minx, maxy - miny)\n",
        "    buffer = max_dim * 0.2\n",
        "    new_half_side = (max_dim / 2) + buffer\n",
        "    ax_main.set_xlim(center_x - new_half_side, center_x + new_half_side)\n",
        "    ax_main.set_ylim(center_y - new_half_side, center_y + new_half_side)\n",
        "    ctx.add_basemap(ax_main, source=ctx.providers.Esri.WorldImagery, crs='epsg:3857', attribution=\"\")\n",
        "    property_proj.plot(ax=ax_main, facecolor=\"none\", edgecolor=\"red\", linewidth=2)\n",
        "    ax_main.spines['top'].set_visible(True); ax_main.spines['right'].set_visible(True); ax_main.spines['bottom'].set_visible(True); ax_main.spines['left'].set_visible(True)\n",
        "    ax_main.set_axis_off()\n",
        "    if ScaleBar is not None:\n",
        "        scalebar = ScaleBar(1, location='lower right', box_alpha=0, border_pad=0.5)\n",
        "        ax_main.add_artist(scalebar)\n",
        "    brazil_aea_proj = \"+proj=aea +lat_0=-12 +lon_0=-54 +lat_1=-2 +lat_2=-22 +x_0=5000000 +y_0=10000000 +ellps=GRS80 +units=m +no_defs\"\n",
        "    property_aea = property_gdf.to_crs(brazil_aea_proj)\n",
        "    area_ha = property_aea.geometry.area.iloc[0] / 10000\n",
        "    area_m2 = property_aea.geometry.area.iloc[0]\n",
        "    perimeter_m = property_aea.geometry.length.iloc[0]\n",
        "\n",
        " \n",
        "    ax_info = fig.add_axes([0.72, 0.05, 0.25, 0.55])\n",
        "    ax_info.axis(\"off\")\n",
        "    table_data = [\n",
        "        [\"City\", f\"{property_gdf['city'].iloc[0]}\"],\n",
        "        [\"State\", f\"{property_gdf['state'].iloc[0]}\"],\n",
        "        [\"Centroid\", f\"{lat:.4f}, {lon:.4f}\"],\n",
        "        [\"Área\", f\"{area_ha:.2f} ha\"],\n",
        "        [\"Perímetro\", f\"{perimeter_m:.2f} m\"]\n",
        "    ]\n",
        "    table = ax_info.table(cellText=table_data, colLabels=[\"Attribute\", \"Value\"], loc='center', cellLoc='left', colWidths=[0.3, 0.7])\n",
        "    table.auto_set_font_size(False)\n",
        "    table.set_fontsize(10)\n",
        "    table.scale(1, 1.5)\n",
        "    if municipalities_gdf is not None and not municipalities_gdf.empty:\n",
        "        states_gdf = load_ibge_states()\n",
        "        state_name = property_gdf['state'].iloc[0]\n",
        "        state_geom = states_gdf[states_gdf['NM_UF'] == state_name]\n",
        "        ax_mini = fig.add_axes([0.72, 0.65, 0.25, 0.25])\n",
        "        state_geom.plot(ax=ax_mini, facecolor=\"#d3d3d3\", edgecolor=\"black\")\n",
        "        municipalities_gdf.plot(ax=ax_mini, facecolor=\"#808080\", edgecolor=\"black\")\n",
        "        property_gdf.centroid.plot(ax=ax_mini, color='red', markersize=50)\n",
        "        ax_mini.spines['top'].set_visible(True); ax_mini.spines['right'].set_visible(True); ax_mini.spines['bottom'].set_visible(True); ax_mini.spines['left'].set_visible(True)\n",
        "        ax_mini.set_axis_off()\n",
        "    return fig\n",
        "\n",
        "# --- Certifique-se de que todas as importações estão no topo ---\n",
        "import matplotlib.pyplot as plt\n",
        "import contextily as ctx\n",
        "from matplotlib_scalebar.scalebar import ScaleBar\n",
        "from pyproj import Transformer\n",
        "from matplotlib.ticker import FuncFormatter\n",
        "import geopandas as gpd\n",
        "import matplotlib.patches as patches\n",
        "\n",
        "def plot_rural_property(property_gdf, municipalities_gdf=None):\n",
        "    \"\"\"\n",
        "    Plota um mapa detalhado de uma propriedade rural com mapa principal,\n",
        "    minimapa de localização e uma tabela de informações estilizada.\n",
        "    \"\"\"\n",
        "    \n",
        "    # Extrai informações básicas de geometria\n",
        "    centroid = property_gdf.geometry.centroid.iloc[0]\n",
        "    lon, lat = centroid.x, centroid.y\n",
        "    \n",
        "    # Configuração inicial da Figura\n",
        "    fig = plt.figure(figsize=(12, 8))\n",
        "    \n",
        "    # --- 1. Eixo Principal (Main Map) ---\n",
        "    ax_main = fig.add_axes([0.05, 0.1, 0.65, 0.85])\n",
        "\n",
        "    # Reprojeta a propriedade para Mercator (EPSG:3857) para o basemap\n",
        "    property_proj = property_gdf.to_crs(epsg=3857)\n",
        "    \n",
        "    # Calcula os limites do mapa com um buffer\n",
        "    minx, miny, maxx, maxy = property_proj.total_bounds\n",
        "    center_x, center_y = (minx + maxx) / 2, (miny + maxy) / 2\n",
        "    max_dim = max(maxx - minx, maxy - miny)\n",
        "    buffer = max_dim * 0.2\n",
        "    new_half_side = (max_dim / 2) + buffer\n",
        "    ax_main.set_xlim(center_x - new_half_side, center_x + new_half_side)\n",
        "    ax_main.set_ylim(center_y - new_half_side, center_y + new_half_side)\n",
        "\n",
        "    # --- 2. Formatadores de Ticks (Converte Mercator para Lat/Lon) ---\n",
        "    transformer_to_latlon = Transformer.from_crs(\"epsg:3857\", \"epsg:4326\")\n",
        "    \n",
        "    # Pega os limites exatos do eixo (em Mercator)\n",
        "    x_min_ax, x_max_ax = ax_main.get_xlim()\n",
        "    y_min_ax, y_max_ax = ax_main.get_ylim()\n",
        "\n",
        "    # Função para formatar o eixo X (Longitude)\n",
        "    def format_lon(x, pos):\n",
        "        # Usa o 'y' da base do mapa (y_min_ax) como referência\n",
        "        lat, lon = transformer_to_latlon.transform(x, y_min_ax)\n",
        "        return f\"{lon:.4f}°\"\n",
        "\n",
        "    # Função para formatar o eixo Y (Latitude)\n",
        "    def format_lat(y, pos):\n",
        "        # Usa o 'x' da esquerda do mapa (x_min_ax) como referência\n",
        "        lat, lon = transformer_to_latlon.transform(x_min_ax, y)\n",
        "        return f\"{lat:.4f}°\"\n",
        "\n",
        "    # Aplica os formatadores\n",
        "    ax_main.xaxis.set_major_formatter(FuncFormatter(format_lon))\n",
        "    ax_main.yaxis.set_major_formatter(FuncFormatter(format_lat))\n",
        "\n",
        "    # --- 3. Adiciona Basemap e Geometrias ao Mapa Principal ---\n",
        "    \n",
        "    # Adiciona o mapa base de satélite\n",
        "    ctx.add_basemap(ax_main, source=ctx.providers.Esri.WorldImagery, crs='epsg:3857', attribution=\"\")\n",
        "    \n",
        "    # Plota a geometria da propriedade\n",
        "    property_proj.plot(ax=ax_main, facecolor=\"none\", edgecolor=\"red\", linewidth=2)\n",
        "\n",
        "    # --- 4. Estilização da Moldura e Ticks do Mapa Principal ---\n",
        "    \n",
        "    # Cria a moldura grossa\n",
        "    frame_width = 2.0\n",
        "    for spine in ax_main.spines.values():\n",
        "        spine.set_visible(True)\n",
        "        spine.set_linewidth(frame_width)\n",
        "\n",
        "    # Estiliza os ticks (rótulos de lat/lon)\n",
        "    ax_main.tick_params(axis='both', which='major', labelsize=9, direction='in', length=6, width=1, pad=5)\n",
        "    plt.setp(ax_main.get_xticklabels(), rotation=30, ha='right') # Rotaciona labels X\n",
        "\n",
        "    # --- 5. Adiciona Barra de Escala ---\n",
        "    if ScaleBar is not None:\n",
        "        scalebar = ScaleBar(1, # 1 metro no sistema de projeção (Mercator)\n",
        "                            location='lower right', \n",
        "                            box_alpha=0, \n",
        "                            border_pad=0.5, \n",
        "                            color='white', \n",
        "                            frameon=False, \n",
        "                            font_properties={'size': 9})\n",
        "        ax_main.add_artist(scalebar)\n",
        "    \n",
        "    # --- 6. Cálculos de Geometria para a Tabela ---\n",
        "    # Projeção Albers Equal Area para cálculos corretos de área/distância no Brasil\n",
        "    brazil_aea_proj = \"+proj=aea +lat_0=-12 +lon_0=-54 +lat_1=-2 +lat_2=-22 +x_0=5000000 +y_0=10000000 +ellps=GRS80 +units=m +no_defs\"\n",
        "    property_aea = property_gdf.to_crs(brazil_aea_proj)\n",
        "    \n",
        "    area_m2 = property_aea.geometry.area.iloc[0]\n",
        "    area_ha = area_m2 / 10000\n",
        "    perimeter_m = property_aea.geometry.length.iloc[0]\n",
        "     \n",
        "    # --- 7. Tabela de Informações Estilizada ---\n",
        "    ax_info = fig.add_axes([0.72, 0.05, 0.25, 0.55])\n",
        "    ax_info.axis(\"off\") # Desliga o eixo do container da tabela\n",
        "    \n",
        "    # Prepara os dados da tabela\n",
        "    table_data = [\n",
        "        [\"City\", f\"{property_gdf['city'].iloc[0]}\"],\n",
        "        [\"State\", f\"{property_gdf['state'].iloc[0]}\"],\n",
        "        [\"Centroid\", f\"{lat:.4f}, {lon:.4f}\"],\n",
        "        [\"Área\", f\"{area_ha:.2f} ha\"],\n",
        "        [\"Perímetro\", f\"{perimeter_m:.2f} m\"],\n",
        "    ]\n",
        "    col_labels = [\"Attribute\", \"Value\"]\n",
        "    num_rows = len(table_data)\n",
        "    num_cols = len(col_labels)\n",
        "\n",
        "    # Cria a tabela\n",
        "    table = ax_info.table(\n",
        "        cellText=table_data, \n",
        "        colLabels=col_labels, \n",
        "        loc='center', \n",
        "        cellLoc='left', \n",
        "        colWidths=[0.3, 0.7] # Largura das colunas\n",
        "    )\n",
        "    \n",
        "    # Ajusta tamanho da fonte e altura das linhas\n",
        "    table.auto_set_font_size(False)\n",
        "    table.set_fontsize(9) # Fonte menor\n",
        "    table.scale(1, 1.8) # Aumenta a altura da linha\n",
        "\n",
        "    # Aplica o estilo (zebrado, negrito, etc.)\n",
        "    for (i, j), cell in table.get_celld().items():\n",
        "        if i == 0: # Linha do Cabeçalho\n",
        "            cell.get_text().set_weight('bold')\n",
        "            cell.set_facecolor('#e0e0e0')\n",
        "        cell.set_edgecolor('#dddddd') # Borda da célula\n",
        "\n",
        "    # Linhas de dados (zebradas e com chave em negrito)\n",
        "    for i in range(num_rows):\n",
        "        bg_color = '#f9f9f9' if i % 2 == 0 else '#ffffff' # Cor da linha (zebrada)\n",
        "        for j in range(num_cols):\n",
        "            table[(i + 1, j)].set_facecolor(bg_color)\n",
        "        \n",
        "        # Define a primeira coluna (chave) em negrito\n",
        "        table[(i + 1, 0)].get_text().set_weight('bold')\n",
        "    \n",
        "    \n",
        "    # --- 8. Minimapa de Localização ---\n",
        "    if municipalities_gdf is not None and not municipalities_gdf.empty:\n",
        "        \n",
        "        # Carrega dados do estado e município\n",
        "        states_gdf = load_ibge_states() \n",
        "        state_name = property_gdf['state'].iloc[0]\n",
        "        city_name = property_gdf['city'].iloc[0]\n",
        "        state_geom = states_gdf[states_gdf['NM_UF'] == state_name]\n",
        "        \n",
        "        # Tenta extrair a sigla do estado\n",
        "        state_uf = \"\" # Valor padrão\n",
        "        if not state_geom.empty:\n",
        "            try:\n",
        "                # Tenta 'SIGLA_UF' primeiro, depois 'abbrev_state' (comum no geobr)\n",
        "                if 'SIGLA_UF' in state_geom.columns:\n",
        "                    state_uf = state_geom['SIGLA_UF'].iloc[0]\n",
        "                elif 'abbrev_state' in state_geom.columns:\n",
        "                    state_uf = state_geom['abbrev_state'].iloc[0]\n",
        "            except (KeyError, IndexError):\n",
        "                pass # Mantém state_uf como \"\"\n",
        "\n",
        "        # Cria o eixo do minimapa\n",
        "        #ax_mini = fig.add_axes([0.72, 0.65, 0.25, 0.25])\n",
        "        ax_mini = fig.add_axes([0.71, 0.62, 0.28, 0.28])\n",
        "        \n",
        "        # Plota as geometrias\n",
        "        state_geom.plot(ax=ax_mini, facecolor=\"#d3d3d3\", edgecolor=\"black\")\n",
        "        municipalities_gdf.plot(ax=ax_mini, facecolor=\"#808080\", edgecolor=\"black\")\n",
        "        property_gdf.centroid.plot(ax=ax_mini, color='red', markersize=20)\n",
        "        \n",
        "        # Adiciona o título\n",
        "        mini_title = f\"{city_name} - {state_uf}\"\n",
        "        ax_mini.set_title(mini_title, fontsize=10, pad=3)\n",
        "\n",
        "        # Habilita a moldura (spines) e desliga os rótulos (ticks)\n",
        "        for spine in ax_mini.spines.values():\n",
        "            spine.set_visible(True)\n",
        "            spine.set_linewidth(1.0)\n",
        "        \n",
        "        ax_mini.set_xticks([])\n",
        "        ax_mini.set_yticks([])\n",
        "        \n",
        "    # --- 9. Adiciona a Moldura Externa à Figura Inteira ---\n",
        "    fig.patches.extend([\n",
        "        patches.Rectangle(\n",
        "            (0.01, 0.01), 0.98, 0.98, # (x,y), width, height\n",
        "            transform=fig.transFigure,\n",
        "            fill=False,\n",
        "            edgecolor='black',\n",
        "            linewidth=2.5\n",
        "        )\n",
        "    ])\n",
        "        \n",
        "    return fig\n",
        "\n",
        "#plot_rural_property(joined, municipalities_gdf=municipio_filtrado)\n",
        "\n",
        "import rioxarray\n",
        "import shapely.geometry\n",
        "import numpy as np\n",
        "import pyproj\n",
        "from shapely.ops import transform\n",
        " \n",
        "def reproject_geom(geom, src_crs, dst_crs):\n",
        "    project = pyproj.Transformer.from_crs(src_crs, dst_crs, always_xy=True).transform\n",
        "    return transform(project, geom)\n",
        " \n",
        "def clip_cog_raster_by_polygon(polygon, raster_cog_path):\n",
        "    raster = rioxarray.open_rasterio(raster_cog_path, masked=True).squeeze(dim='band')\n",
        "    raster_crs = raster.rio.crs\n",
        "    if not polygon.is_valid:\n",
        "        polygon = polygon.buffer(0)\n",
        "    if polygon.is_empty:\n",
        "        raise ValueError(\"Input polygon is empty after validation.\")\n",
        "    minx, miny, maxx, maxy = polygon.bounds\n",
        "    if raster_crs.to_string() != 'EPSG:4326':\n",
        "        polygon_proj = reproject_geom(polygon, \"EPSG:4326\", raster_crs)\n",
        "        project = pyproj.Transformer.from_crs(\"EPSG:4326\", raster_crs, always_xy=True).transform\n",
        "        minx_proj, miny_proj = project(minx, miny)\n",
        "        maxx_proj, maxy_proj = project(maxx, maxy)\n",
        "        raster_subset = raster.sel(x=slice(minx_proj, maxx_proj), y=slice(maxy_proj, miny_proj))\n",
        "    else:\n",
        "        polygon_proj = polygon\n",
        "        raster_subset = raster.sel(x=slice(minx, maxx), y=slice(maxy, miny))\n",
        "    clipped = raster_subset.rio.clip([shapely.geometry.mapping(polygon_proj)], raster_crs, from_disk=True, all_touched=True)\n",
        "    bounds_proj = clipped.rio.bounds()\n",
        "    if raster_crs.to_string() != 'EPSG:4326':\n",
        "        project_back = pyproj.Transformer.from_crs(raster_crs, \"EPSG:4326\", always_xy=True).transform\n",
        "        minx_b, miny_b = project_back(bounds_proj[0], bounds_proj[1])\n",
        "        maxx_b, maxy_b = project_back(bounds_proj[2], bounds_proj[3])\n",
        "        bbox_4326 = (minx_b, miny_b, maxx_b, maxy_b)\n",
        "    else:\n",
        "        bbox_4326 = bounds_proj\n",
        "    return clipped, bbox_4326\n",
        " \n",
        "def plot(imagem_cortada, bbox, classes_df, largura_figuras=10):\n",
        "    fig, ax = plt.subplots(figsize=(largura_figuras, 4))\n",
        "    data = imagem_cortada.values\n",
        "    if {'Class_ID', 'Label', 'Descricao', 'Color'}.issubset(classes_df.columns):\n",
        "        class_ids, colors, labels = classes_df['Class_ID'].values, classes_df['Color'].values, classes_df['Label'].values\n",
        "    elif {'Class_ID', 'Level', 'Description', 'Descricao', 'Color'}.issubset(classes_df.columns):\n",
        "        class_ids, colors, labels = classes_df['Class_ID'].values, classes_df['Color'].values, classes_df['Description'].values\n",
        "    else:\n",
        "        raise ValueError(\"DataFrame columns do not match expected formats.\")\n",
        "    color_dict = dict(zip(class_ids, colors))\n",
        "    rgb_image = np.empty(data.shape + (4,), dtype=np.float32)\n",
        "    rgb_image[:] = [1, 1, 1, 0]\n",
        "    for class_id, hex_color in color_dict.items():\n",
        "        mask = data == class_id\n",
        "        if np.any(mask):\n",
        "            hex_color = hex_color.lstrip('#')\n",
        "            r, g, b = tuple(int(hex_color[i:i+2], 16)/255.0 for i in (0, 2, 4))\n",
        "            rgb_image[mask] = [r, g, b, 1]\n",
        "    xmin, ymin, xmax, ymax = bbox\n",
        "    ax.imshow(rgb_image, extent=[xmin, xmax, ymin, ymax], origin='upper')\n",
        "    patches = [mpatches.Patch(color=color, label=label) for label, color in zip(labels, colors)]\n",
        "    ax.legend(handles=patches, bbox_to_anchor=(1.05, 1), loc='upper left', borderaxespad=0.)\n",
        "    ax.set_xlim(xmin, xmax); ax.set_ylim(ymin, ymax)\n",
        "    ax.set_xlabel('Longitude'); ax.set_ylabel('Latitude')\n",
        "    ax.set_title('Raster Plot with Legend')\n",
        "    fig.tight_layout(rect=[0, 0, 0.85, 1])\n",
        "    return fig, ax\n",
        " \n",
        "def generate_grid_points_by_distance(geometry_4326, spacing_meters):\n",
        "    gs = gpd.GeoSeries([geometry_4326], crs=\"EPSG:4326\")\n",
        "    utm_crs = gs.estimate_utm_crs()\n",
        "    geometry_proj = gs.to_crs(utm_crs).iloc[0]\n",
        "    minx, miny, maxx, maxy = geometry_proj.bounds\n",
        "    x_coords = np.arange(minx + spacing_meters/2, maxx, spacing_meters)\n",
        "    y_coords = np.arange(miny + spacing_meters/2, maxy, spacing_meters)\n",
        "    points_proj = [Point(x, y) for x in x_coords for y in y_coords if geometry_proj.contains(Point(x, y))]\n",
        "    if not points_proj: return []\n",
        "    points_gdf_proj = gpd.GeoDataFrame(geometry=points_proj, crs=utm_crs)\n",
        "    points_gdf_4326 = points_gdf_proj.to_crs(\"EPSG:4326\")\n",
        "    return list(points_gdf_4326.geometry)\n",
        " \n",
        "import rasterio\n",
        "from rasterio.mask import mask, geometry_mask\n",
        "from rasterio.errors import RasterioIOError\n",
        "from rasterio._err import CPLE_AppDefinedError\n",
        " \n",
        "def retry_rasterio_open(href, max_retries=5, delay=15):\n",
        "    for attempt in range(max_retries):\n",
        "        try:\n",
        "            with rasterio.Env(GDAL_HTTP_TIMEOUT=60, GDAL_HTTP_CONNECTTIMEOUT=20):\n",
        "                return rasterio.open(href)\n",
        "        except (RasterioIOError, CPLE_AppDefinedError) as e:\n",
        "            if 'CURL' in str(e) or 'HTTP' in str(e) or 'Timeout' in str(e):\n",
        "                print_status(f\"   - Network error on attempt {attempt + 1}/{max_retries}: {e}. Retrying in {delay}s...\")\n",
        "                time.sleep(delay)\n",
        "            else: raise\n",
        "    raise RasterioIOError(f\"Failed to open {href} after {max_retries} attempts.\")\n",
        " \n",
        "\n",
        "def _open_asset(item, banda):\n",
        "    \"\"\"Return a rasterio DatasetReader for the given asset if present, else None.\"\"\"\n",
        "    asset = item.assets.get(banda)\n",
        "    if asset is None:\n",
        "        return None\n",
        "    return retry_rasterio_open(asset.href)\n",
        "\n",
        "\n",
        "def merge_band_for_date(items_on_date, banda, gleba):\n",
        "    \"\"\"Merge the given band across all items in items_on_date using rasterio.merge.\n",
        "\n",
        "    Optimization: for each item, read only the masked crop (rasterio.mask.mask) using the\n",
        "    gleba geometry transformed to the dataset CRS. Then mosaic the small crops in-memory.\n",
        "\n",
        "    Returns: merged_array (2D float32) or None, out_transform, out_crs\n",
        "    \"\"\"\n",
        "    sources = []  # temporary list of (array, transform)\n",
        "    out_crs = None\n",
        "    for item in items_on_date:\n",
        "        ds = _open_asset(item, banda)\n",
        "        if ds is None:\n",
        "            continue\n",
        "        try:\n",
        "            # project gleba to dataset CRS and mask\n",
        "            try:\n",
        "                gleba_proj = gleba.to_crs(ds.crs)\n",
        "            except Exception:\n",
        "                # if gleba has no CRS info or conversion fails, assume it's already in ds.crs\n",
        "                gleba_proj = gleba\n",
        "\n",
        "            # extract single geometry mapping for mask\n",
        "            if isinstance(gleba_proj, gpd.GeoDataFrame):\n",
        "                geom = mapping(gleba_proj.iloc[0].geometry)\n",
        "            else:\n",
        "                # assume shapely geometry\n",
        "                geom = mapping(gleba_proj.geometry if hasattr(gleba_proj, 'geometry') else gleba_proj)\n",
        "\n",
        "            out_image, out_transform = mask(ds, [geom], crop=True)\n",
        "            if out_image is None or out_image.size == 0:\n",
        "                continue\n",
        "\n",
        "            # store array + transform for in-memory merge\n",
        "            sources.append((out_image[0].astype(np.float32), out_transform))\n",
        "            if out_crs is None:\n",
        "                out_crs = ds.crs\n",
        "        except Exception as e:\n",
        "            print_status(f\"Warning: failed to read/mask asset {banda} from item {getattr(item, 'id', '')}: {e}\")\n",
        "        finally:\n",
        "            try:\n",
        "                ds.close()\n",
        "            except Exception:\n",
        "                pass\n",
        "\n",
        "    if len(sources) == 0:\n",
        "        return None, None, None\n",
        "\n",
        "    # rasterio.merge expects dataset-like objects with .profile/.crs; create MemoryFile datasets\n",
        "    memfiles = []\n",
        "    datasets = []\n",
        "    try:\n",
        "        for arr, tr in sources:\n",
        "            profile = {\n",
        "                'driver': 'GTiff',\n",
        "                'height': int(arr.shape[0]),\n",
        "                'width': int(arr.shape[1]),\n",
        "                'count': 1,\n",
        "                'dtype': arr.dtype,\n",
        "                'transform': tr,\n",
        "                'crs': out_crs,\n",
        "            }\n",
        "            mf = MemoryFile()\n",
        "            dst = mf.open(**profile)\n",
        "            dst.write(arr, 1)\n",
        "            dst.close()\n",
        "            # reopen for reading by merge\n",
        "            ds_read = mf.open()\n",
        "            memfiles.append(mf)\n",
        "            datasets.append(ds_read)\n",
        "\n",
        "        merged, out_transform = merge(datasets)\n",
        "        merged_arr = merged[0].astype(np.float32)\n",
        "        return merged_arr, out_transform, out_crs\n",
        "    finally:\n",
        "        for ds in datasets:\n",
        "            try:\n",
        "                ds.close()\n",
        "            except Exception:\n",
        "                pass\n",
        "        # keep memfiles out of scope to allow GC later; they will be closed when objects are collected\n",
        "\n",
        "\n",
        "def reproject_to_target(src_arr, src_transform, src_crs, dst_shape, dst_transform, dst_crs, resampling=Resampling.bilinear):\n",
        "    \"\"\"Reprojects/resamples a 2D numpy array to the given destination transform/shape/crs.\"\"\"\n",
        "    dst = np.full(dst_shape, np.nan, dtype=np.float32)\n",
        "    reproject(\n",
        "        source=src_arr,\n",
        "        destination=dst,\n",
        "        src_transform=src_transform,\n",
        "        src_crs=src_crs,\n",
        "        dst_transform=dst_transform,\n",
        "        dst_crs=dst_crs,\n",
        "        resampling=resampling,\n",
        "        num_threads=2,\n",
        "    )\n",
        "    return dst\n",
        "\n",
        " \n",
        "def carregar_banda_sentinel2_bdc(item, banda, gleba):\n",
        "    asset = item.assets.get(banda)\n",
        "    if asset is None: raise ValueError(f\"Band {banda} not found in item assets.\")\n",
        "    with retry_rasterio_open(asset.href) as src:\n",
        "        gleba_proj = gleba.to_crs(src.crs) if gleba.crs != src.crs else gleba\n",
        "        geoms = [feature[\"geometry\"] for feature in gleba_proj.__geo_interface__[\"features\"]] if hasattr(gleba_proj, \"__geo_interface__\") else [gleba_proj.geometry]\n",
        "        out_image, out_transform = mask(src, geoms, crop=True)\n",
        "        return out_image[0].astype(np.float32)\n",
        " \n",
        "def carregar_banda_sentinel2_bdc_scl(item, banda, gleba, banda_scl_zoom):\n",
        "    banda_array = carregar_banda_sentinel2_bdc(item, banda, gleba)\n",
        "    if banda_array.shape != banda_scl_zoom.shape:\n",
        "        banda_array = resize(banda_array, banda_scl_zoom.shape, order=1, preserve_range=True, anti_aliasing=True).astype(np.float32)\n",
        "    cloud_classes = [3, 7, 8, 9, 10, 11]\n",
        "    mask_clouds = np.isin(banda_scl_zoom, cloud_classes)\n",
        "    return np.where(mask_clouds, np.nan, banda_array)\n",
        " \n",
        "def apply_scl_mask(scl_arr, target_shape, scl_transform, scl_crs, ref_transform, ref_crs, ref_shape):\n",
        "    \"\"\"Resample SCL to reference and create boolean cloud mask (True=cloud)\"\"\"\n",
        "    scl_resampled = reproject_to_target(scl_arr, scl_transform, scl_crs, ref_shape, ref_transform, ref_crs, resampling=Resampling.nearest)\n",
        "    cloud_classes = [3, 7, 8, 9, 10, 11]\n",
        "    mask_clouds = np.isin(scl_resampled, cloud_classes)\n",
        "    return mask_clouds\n",
        "\n",
        "def aplicar_contraste_raiz(array, L, N):\n",
        "    return np.power(array / L, 1/N) * L\n",
        "\n",
        "def normalizar(array, L):\n",
        "    arr_min, arr_max = np.nanmin(array), np.nanmax(array)\n",
        "    if arr_max - arr_min == 0: return np.zeros_like(array)\n",
        "    return (array - arr_min) / (arr_max - arr_min) * L\n",
        "\n",
        "def merge_assets_by_date(time_ordered_items, gleba_geo):\n",
        "    G, C1, C2, L_evi, SCALE_FACTOR = 2.5, 6.0, 7.5, 1.0, 10000.0\n",
        "    grouped_items = defaultdict(list)\n",
        "    for item in time_ordered_items:\n",
        "        date = item.properties['datetime'][:10]\n",
        "        grouped_items[date].append(item)\n",
        "\n",
        "    merged_assets = {}\n",
        "    for date, items_on_date in grouped_items.items():\n",
        "        # Merge bands across items for this date\n",
        "        b02, t02, crs02 = merge_band_for_date(items_on_date, 'B02', gleba_geo)\n",
        "        b04, t04, crs04 = merge_band_for_date(items_on_date, 'B04', gleba_geo)\n",
        "        b08, t08, crs08 = merge_band_for_date(items_on_date, 'B08', gleba_geo)\n",
        "        b11, t11, crs11 = merge_band_for_date(items_on_date, 'B11', gleba_geo)\n",
        "        scl, tscl, crsscl = merge_band_for_date(items_on_date, 'SCL', gleba_geo)\n",
        "\n",
        "        # Need B02, B04 and B08 for EVI calculation\n",
        "        if b02 is None or b04 is None or b08 is None:\n",
        "            print_status(f\"Skipping date {date}: missing one of B02/B04/B08 after merge\")\n",
        "            continue\n",
        "\n",
        "        # Use B02 as reference grid (usually 10m)\n",
        "        ref_arr = b02\n",
        "        ref_transform = t02\n",
        "        ref_crs = crs02\n",
        "        ref_shape = ref_arr.shape\n",
        "\n",
        "        # Reproject other bands to reference grid if needed\n",
        "        if t04 is None:\n",
        "            print_status(f\"B04 missing for date {date}\")\n",
        "            continue\n",
        "        if not (np.allclose(t04.to_gdal(), ref_transform.to_gdal()) if hasattr(t04, 'to_gdal') else True):\n",
        "            b04 = reproject_to_target(b04, t04, crs04, ref_shape, ref_transform, ref_crs, resampling=Resampling.bilinear)\n",
        "\n",
        "        if t08 is None:\n",
        "            print_status(f\"B08 missing for date {date}\")\n",
        "            continue\n",
        "        if not (np.allclose(t08.to_gdal(), ref_transform.to_gdal()) if hasattr(t08, 'to_gdal') else True):\n",
        "            b08 = reproject_to_target(b08, t08, crs08, ref_shape, ref_transform, ref_crs, resampling=Resampling.bilinear)\n",
        "\n",
        "        if b11 is not None and t11 is not None:\n",
        "            b11 = reproject_to_target(b11, t11, crs11, ref_shape, ref_transform, ref_crs, resampling=Resampling.bilinear)\n",
        "\n",
        "        # Resample SCL and get cloud mask\n",
        "        cloud_mask = None\n",
        "        if scl is not None and tscl is not None:\n",
        "            cloud_mask = apply_scl_mask(scl, scl.shape, tscl, crsscl, ref_transform, ref_crs, ref_shape)\n",
        "\n",
        "        # Mask outside gleba geometry\n",
        "        try:\n",
        "            gleba_proj = gleba_geo.to_crs(ref_crs).iloc[0]\n",
        "            inside_mask = ~geometry_mask([mapping(gleba_proj)], transform=ref_transform, out_shape=ref_shape)\n",
        "        except Exception:\n",
        "            inside_mask = np.ones(ref_shape, dtype=bool)\n",
        "\n",
        "        # Apply inside/inside-mask and cloud mask\n",
        "        def mask_to_nan(arr):\n",
        "            if arr is None:\n",
        "                return None\n",
        "            arr = arr.astype(np.float32)\n",
        "            arr[~inside_mask] = np.nan\n",
        "            if cloud_mask is not None:\n",
        "                arr[cloud_mask] = np.nan\n",
        "            return arr\n",
        "\n",
        "        b02_m = mask_to_nan(b02)\n",
        "        b04_m = mask_to_nan(b04)\n",
        "        b08_m = mask_to_nan(b08)\n",
        "        b11_m = mask_to_nan(b11) if b11 is not None else None\n",
        "\n",
        "        # Build RGB matrix (channels: R=NIR(B08), G=B11 (resampled), B=B04)\n",
        "        L, N = 2**12, 2\n",
        "        matriz_rgb = np.zeros((ref_shape[0], ref_shape[1], 3), dtype=np.float32)\n",
        "        matriz_rgb[:, :, 0] = aplicar_contraste_raiz(normalizar(b08_m, L), L, N) / L if b08_m is not None else np.zeros(ref_shape, dtype=np.float32)\n",
        "        if b11_m is not None:\n",
        "            matriz_rgb[:, :, 1] = aplicar_contraste_raiz(normalizar(b11_m, L), L, N) / L\n",
        "        else:\n",
        "            matriz_rgb[:, :, 1] = np.zeros(ref_shape, dtype=np.float32)\n",
        "        matriz_rgb[:, :, 2] = aplicar_contraste_raiz(normalizar(b04_m, L), L, N) / L if b04_m is not None else np.zeros(ref_shape, dtype=np.float32)\n",
        "\n",
        "        # Compute EVI\n",
        "        refl_02 = b02_m.astype(np.float32) / SCALE_FACTOR\n",
        "        refl_04 = b04_m.astype(np.float32) / SCALE_FACTOR\n",
        "        refl_08 = b08_m.astype(np.float32) / SCALE_FACTOR\n",
        "        numerator = G * (refl_08 - refl_04)\n",
        "        denominator = (refl_08 + C1 * refl_04 - C2 * refl_02 + L_evi)\n",
        "        banda_evi = np.divide(numerator, denominator, where=(denominator != 0))\n",
        "\n",
        "        merged_assets[date] = {'rgb': matriz_rgb, 'evi': banda_evi}\n",
        "    return merged_assets\n",
        "\n",
        "\n",
        "def get_and_plot_areal_ts_wtss(cubo, gleba_4326, gleba_id):\n",
        "    \"\"\"\n",
        "    Busca e plota a série temporal média de 6 anos para a gleba inteira\n",
        "    usando a função summarize (geom=) do WTSS.\n",
        "    \n",
        "    Args:\n",
        "        gleba_4326 (shapely.geometry): A geometria da gleba em EPSG:4326.\n",
        "        gleba_id (str): O ID da gleba para o título.\n",
        "    \"\"\"\n",
        "\n",
        "    print_status(\"   - Definindo período de 6 anos para série temporal média (WTSS)...\")\n",
        "    end_date_dt = datetime.now()\n",
        "    start_date_dt = end_date_dt - relativedelta(years=10)\n",
        "    start_date_str = start_date_dt.strftime('%Y-%m-%d')\n",
        "    end_date_str = end_date_dt.strftime('%Y-%m-%d')\n",
        "    \n",
        "    print_status(f\"   - Buscando série temporal sumarizada de {start_date_str} a {end_date_str}...\")\n",
        "    \n",
        "    # 1. Chamar coverage.ts com a geometria (EPSG:4326)\n",
        "    # Adicionado: Verificação para geometria vazia e conversão para GeoJSON para robustez.\n",
        "    if gleba_4326.is_empty:\n",
        "        print_status(\"   - AVISO: A geometria da gleba está vazia. Não é possível buscar a série temporal.\")\n",
        "        return None\n",
        "\n",
        "    # Simplifica a geometria para evitar URLs muito longas que causam erro 400 (Bad Request)\n",
        "    # e a converte para um dicionário GeoJSON para garantir compatibilidade.\n",
        "    #gleba_simplificada = gleba_4326.simplify(tolerance=0.0001, preserve_topology=True)\n",
        "    gleba_geojson = gleba_4326.__geo_interface__\n",
        "    timeseries = cubo.ts(\n",
        "        attributes=('NDVI',), # Fetch SCL for cloud masking\n",
        "        geom=gleba_geojson,\n",
        "        start_date=start_date_str,\n",
        "        end_date=end_date_str,\n",
        "    )\n",
        "    \n",
        "    # 2. Chamar summarize\n",
        "    print_status(\"   - Sumarizando dados...\")\n",
        "    summarize = timeseries.summarize()\n",
        "    \n",
        "    # 3. Plotar (usando o estilo do exemplo fornecido)\n",
        "    print_status(\"   - Plotando gráfico da média...\")\n",
        "    \n",
        "    # Define uma paleta de cores mais corporativa\n",
        "    corporate_blue = '#003366'\n",
        "    fill_color = '#e6f0f7'\n",
        "    grid_color = '#cccccc'\n",
        "    \n",
        "    fig, ax = plt.subplots(figsize=(15, 6))\n",
        "    \n",
        "    # Extrai o DataFrame com todos os pixels usando o método .df()\n",
        "    df = summarize.df()\n",
        "\n",
        "    # --- This is the conversion snippet ---\n",
        "\n",
        "    # 2. Create the new combined column name\n",
        "    # This joins 'NDVI' and 'min' to create 'NDVI_min', etc.\n",
        "    df['band_agg'] = df['attribute'] + '_' + df['aggregation']\n",
        "\n",
        "    # 3. Pivot the DataFrame\n",
        "    # - index='datetime': makes datetime the unique rows\n",
        "    # - columns='band_agg': makes the new combined names the columns\n",
        "    # - values='value': fills the grid with the corresponding values\n",
        "    wide_df = df.pivot(index='datetime', columns='band_agg', values='value')\n",
        "\n",
        "    # 4. Clean up the DataFrame (optional but recommended)\n",
        "    # 'pivot' makes 'datetime' the index. reset_index() turns it back into a column.\n",
        "    wide_df = wide_df.reset_index()\n",
        "    # Remove the index name ('band_agg') from the top of the column index\n",
        "    wide_df.columns.name = None\n",
        "\n",
        "    # --- End of conversion snippet ---\n",
        "\n",
        "    # Calcula a média de todos os pixels para cada data (linha) e cria o DataFrame final\n",
        "    df_ts = wide_df\n",
        "\n",
        "    # --- Smoothing Step ---\n",
        "    # Aplica o filtro Savitzky-Golay para suavizar a série temporal\n",
        "    # Itera sobre todas as colunas, exceto 'datetime', e aplica o filtro\n",
        "    for col in df_ts.columns:\n",
        "        if col != 'datetime' and pd.api.types.is_numeric_dtype(df_ts[col]):\n",
        "            # O filtro requer que o window_length seja ímpar e menor que o número de pontos\n",
        "            if len(df_ts[col]) > 9:\n",
        "                df_ts[col] = savgol_filter(df_ts[col], window_length=9, polyorder=2)\n",
        "\n",
        "    # Verifica se há dados para plotar\n",
        "    if not df_ts.empty:\n",
        "        # Extrai os dados de data (índice) e valor (coluna 'NDVI_mean')\n",
        "        x_data = df_ts.datetime\n",
        "        y_data = df_ts['NDVI_mean']\n",
        "        \n",
        "        # Plota a linha principal (agora suavizada) com Matplotlib\n",
        "        ax.plot(x_data, y_data, color=corporate_blue, linewidth=2.0)\n",
        "        \n",
        "        # Preenche a área sob a curva para um visual mais rico\n",
        "        ax.fill_between(x_data, y_data, color=fill_color, alpha=0.7)\n",
        "    \n",
        "    # Ajustes de estilo para um visual mais limpo e profissional\n",
        "    ax.set_title(f'Série Temporal Média de NDVI (Últimos 6 anos) - Gleba {gleba_id}', loc='left', fontsize=14, fontweight='bold')\n",
        "    ax.set_xlabel('Data', fontsize=10)\n",
        "    ax.set_ylabel('NDVI Médio', fontsize=10)\n",
        "    ax.set_ylim(0.0, 1.0) # Forçar a escala de NDVI\n",
        "    ax.grid(axis='y', linestyle='-', alpha=0.5, color=grid_color)\n",
        "    ax.spines['top'].set_visible(False)\n",
        "    ax.spines['right'].set_visible(False)\n",
        "    \n",
        "    return fig\n",
        "\n",
        "def get_and_plot_areal_ts_wtss(cubo, gleba_4326, gleba_id, planting_period=None, harvesting_period=None):\n",
        "    \"\"\"\n",
        "    Busca e plota a série temporal média de 6 anos para a gleba inteira\n",
        "    usando a função summarize (geom=) do WTSS.\n",
        "    \n",
        "    Args:\n",
        "        gleba_4326 (shapely.geometry): A geometria da gleba em EPSG:4326.\n",
        "        gleba_id (str): O ID da gleba para o título.\n",
        "        planting_period (tuple, optional): Tupla com (start_date, end_date) do plantio.\n",
        "        harvesting_period (tuple, optional): Tupla com (start_date, end_date) da colheita.\n",
        "    \"\"\"\n",
        "\n",
        "    print_status(\"   - Definindo período de 6 anos para série temporal média (WTSS)...\")\n",
        "    end_date_dt = datetime.now()\n",
        "    start_date_dt = end_date_dt - relativedelta(years=6)\n",
        "    start_date_str = start_date_dt.strftime('%Y-%m-%d')\n",
        "    end_date_str = end_date_dt.strftime('%Y-%m-%d')\n",
        "    \n",
        "    print_status(f\"   - Buscando série temporal sumarizada de {start_date_str} a {end_date_str}...\")\n",
        "\n",
        "    # Simplifica a geometria para evitar URLs muito longas que causam erro 400 (Bad Request)\n",
        "    # e a converte para um dicionário GeoJSON para garantir compatibilidade.\n",
        "    #gleba_simplificada = gleba_4326.simplify(tolerance=0.0001, preserve_topology=True)\n",
        "    gleba_geojson = gleba_4326.__geo_interface__\n",
        "    timeseries = cubo.ts(\n",
        "        attributes=('NDVI',), # Fetch SCL for cloud masking\n",
        "        geom=gleba_geojson,\n",
        "        start_date=start_date_str,\n",
        "        end_date=end_date_str,\n",
        "    )\n",
        "    \n",
        "    # 2. Chamar summarize\n",
        "    print_status(\"   - Sumarizando dados...\")\n",
        "    summarize = timeseries.summarize()\n",
        "    \n",
        "    # 3. Plotar (usando o estilo do exemplo fornecido)\n",
        "    print_status(\"   - Plotando gráfico da média...\")\n",
        "    \n",
        "    # Define uma paleta de cores mais corporativa\n",
        "    corporate_blue = '#003366'\n",
        "    fill_color = '#e6f0f7'\n",
        "    grid_color = '#cccccc'\n",
        "    \n",
        "    fig, ax = plt.subplots(figsize=(15, 6))\n",
        "    \n",
        "    # Extrai o DataFrame com todos os pixels usando o método .df()\n",
        "    df = summarize.df()\n",
        "\n",
        "    # --- This is the conversion snippet ---\n",
        "\n",
        "    # 2. Create the new combined column name\n",
        "    # This joins 'NDVI' and 'min' to create 'NDVI_min', etc.\n",
        "    df['band_agg'] = df['attribute'] + '_' + df['aggregation']\n",
        "\n",
        "    # 3. Pivot the DataFrame\n",
        "    # - index='datetime': makes datetime the unique rows\n",
        "    # - columns='band_agg': makes the new combined names the columns\n",
        "    # - values='value': fills the grid with the corresponding values\n",
        "    wide_df = df.pivot(index='datetime', columns='band_agg', values='value')\n",
        "\n",
        "    # 4. Clean up the DataFrame (optional but recommended)\n",
        "    # 'pivot' makes 'datetime' the index. reset_index() turns it back into a column.\n",
        "    wide_df = wide_df.reset_index()\n",
        "    # Remove the index name ('band_agg') from the top of the column index\n",
        "    wide_df.columns.name = None\n",
        "\n",
        "    # --- End of conversion snippet ---\n",
        "\n",
        "    # Calcula a média de todos os pixels para cada data (linha) e cria o DataFrame final\n",
        "    df_ts = wide_df\n",
        "\n",
        "    # --- Smoothing Step ---\n",
        "    # Aplica o filtro Savitzky-Golay para suavizar a série temporal\n",
        "    # Itera sobre todas as colunas, exceto 'datetime', e aplica o filtro\n",
        "    for col in df_ts.columns:\n",
        "        if col != 'datetime' and pd.api.types.is_numeric_dtype(df_ts[col]):\n",
        "            # O filtro requer que o window_length seja ímpar e menor que o número de pontos\n",
        "            if len(df_ts[col]) > 5:\n",
        "                df_ts[col] = savgol_filter(df_ts[col], window_length=5, polyorder=2)\n",
        "\n",
        "    # Verifica se há dados para plotar\n",
        "    if not df_ts.empty:\n",
        "        # Extrai os dados de data (índice) e valor (coluna 'NDVI_mean')\n",
        "        x_data = df_ts.datetime\n",
        "        y_data = df_ts['NDVI_mean']\n",
        "        \n",
        "        # Plota a linha principal (agora suavizada) com Matplotlib\n",
        "        ax.plot(x_data, y_data, color=corporate_blue, linewidth=2.0)\n",
        "        \n",
        "        # Preenche a área sob a curva para um visual mais rico\n",
        "        ax.fill_between(x_data, y_data, color=fill_color, alpha=0.7)\n",
        "\n",
        "    # --- Adiciona as janelas de plantio e colheita ---\n",
        "    if planting_period:\n",
        "        try:\n",
        "            plant_start, plant_end = pd.to_datetime(planting_period[0]), pd.to_datetime(planting_period[1])\n",
        "            ax.axvspan(plant_start, plant_end, color='green', alpha=0.2, label='Janela de Plantio Esperada')\n",
        "        except (TypeError, IndexError, ValueError) as e:\n",
        "            print_status(f\"   - AVISO: Formato inválido para planting_period. Esperado (start, end). Erro: {e}\")\n",
        "\n",
        "    if harvesting_period:\n",
        "        try:\n",
        "            harvest_start, harvest_end = pd.to_datetime(harvesting_period[0]), pd.to_datetime(harvesting_period[1])\n",
        "            ax.axvspan(harvest_start, harvest_end, color='orange', alpha=0.2, label='Janela de Colheita Esperada')\n",
        "        except (TypeError, IndexError, ValueError) as e:\n",
        "            print_status(f\"   - AVISO: Formato inválido para harvesting_period. Esperado (start, end). Erro: {e}\")\n",
        "\n",
        "    # Ajustes de estilo para um visual mais limpo e profissional\n",
        "    ax.set_title(f'Série Temporal Média de NDVI (Últimos 6 anos) - Gleba {gleba_id}', loc='left', fontsize=14, fontweight='bold')\n",
        "    ax.set_xlabel('Data', fontsize=10)\n",
        "    ax.set_ylabel('NDVI Médio', fontsize=10)\n",
        "    ax.set_ylim(0.0, 1.0) # Forçar a escala de NDVI\n",
        "    # Adiciona a legenda para incluir as janelas de plantio/colheita, se existirem\n",
        "    if planting_period or harvesting_period:\n",
        "        ax.legend(loc='upper left')\n",
        "    ax.grid(axis='y', linestyle='-', alpha=0.5, color=grid_color)\n",
        "    ax.spines['top'].set_visible(False)\n",
        "    ax.spines['right'].set_visible(False)\n",
        "    \n",
        "    return fig\n",
        "\n",
        "def process_cube(shapefile, query_bands, start_date, end_date, collections, stac_url, resolution=10):\n",
        "    print_status(\"   - Opening STAC catalog and searching for items...\")\n",
        "    catalog = pystac_client.Client.open(stac_url)\n",
        "    items = catalog.search(collections=collections, bbox=shapefile.total_bounds.tolist(), datetime=f\"{start_date}/{end_date}\").get_all_items()\n",
        "    filtered_items = sorted([item for item in items if all(band in item.assets for band in query_bands)], key=lambda x: x.datetime)\n",
        "    if not filtered_items: raise RuntimeError(\"No items found with all requested bands.\")\n",
        "    print_status(f\"   - Found {len(filtered_items)} items. Loading data cube with odc-stac...\")\n",
        "    geom = shapefile.geometry.iloc[0]\n",
        "    utm_crs = shapefile.estimate_utm_crs()\n",
        "    print_status(f\"   - Using projected CRS: {utm_crs.to_string()}\")\n",
        "    with dask.diagnostics.ProgressBar():\n",
        "        cube = stac_load(filtered_items, bands=query_bands, crs=utm_crs, resolution=resolution, geopolygon=geom, resampling={\"SCL\": \"nearest\", \"*\": \"bilinear\"}, chunks={\"x\": 2048, \"y\": 2048})\n",
        "    if \"NDVI\" in cube:\n",
        "        print_status(\"   - Applying scale factor to NDVI band...\")\n",
        "        cube[\"NDVI\"] = cube[\"NDVI\"] / 10000.0\n",
        "    if \"SCL\" in cube:\n",
        "        valid_scl_codes = [4, 5, 6]\n",
        "        scl_mask = cube[\"SCL\"].isin(valid_scl_codes).any(dim=\"time\")\n",
        "    else:\n",
        "        scl_mask = xr.ones_like(cube[query_bands[0]].isel(time=0), dtype=bool)\n",
        "    cube = cube.rio.write_crs(utm_crs, inplace=False).rio.clip(shapefile.geometry.values, shapefile.crs, drop=False, invert=False)\n",
        "    geom_mask = ~cube.isnull().to_array().all(\"variable\").any(\"time\")\n",
        "    spatial_mask = scl_mask & geom_mask\n",
        "    print_status(\"   - Creating monthly maximum value composites...\")\n",
        "    if \"SCL\" in cube:\n",
        "        cube = cube.where(cube[\"SCL\"].isin(valid_scl_codes))\n",
        "    monthly_cube = cube.resample(time=\"1M\").max(skipna=True).chunk({\"time\": -1}).interpolate_na(dim=\"time\", method=\"linear\").bfill(dim=\"time\").ffill(dim=\"time\")\n",
        "    final_cube = monthly_cube.drop_vars(\"SCL\", errors=\"ignore\")\n",
        "    masked_bands = {band: da.where(spatial_mask, -1) for band, da in final_cube.data_vars.items()}\n",
        "    final_cube = xr.Dataset(masked_bands, coords=final_cube.coords)\n",
        "    return final_cube.compute(), spatial_mask.compute()\n",
        " \n",
        "def som_time_series_clustering(cube, mask, n=2, random_seed=123, training_steps=100):\n",
        "    cube_da = cube['NDVI']\n",
        "    data = cube_da.transpose('y', 'x', 'time').values\n",
        "    data = data.reshape(data.shape[0] * data.shape[1], data.shape[2])\n",
        "    mask_flat = mask.values.flatten()\n",
        "    data_valid = data[mask_flat]\n",
        "    if data_valid.shape[0] == 0: raise ValueError(\"No valid data points to cluster after masking.\")\n",
        "    print_status(\"   - Normalizing time series data...\")\n",
        "    scaler = StandardScaler()\n",
        "    data_scaled = scaler.fit_transform(data_valid)\n",
        "    print_status(\"   - Training SOM...\")\n",
        "    som = MiniSom(n, n, data_scaled.shape[1], sigma=1.0, learning_rate=0.5, random_seed=random_seed)\n",
        "    som.random_weights_init(data_scaled)\n",
        "    som.train_random(data_scaled, training_steps)\n",
        "    neuron_weights_scaled = som.get_weights().reshape(n*n, -1)\n",
        "    neuron_weights = scaler.inverse_transform(neuron_weights_scaled)\n",
        "    winners = np.array([som.winner(x) for x in data_scaled])\n",
        "    predictions_valid = winners[:, 0] * n + winners[:, 1]\n",
        "    predictions = -1 * np.ones(mask_flat.shape, dtype=int)\n",
        "    predictions[mask_flat] = predictions_valid\n",
        "    predictions = predictions.reshape(mask.shape)\n",
        "    return predictions, neuron_weights, predictions, som\n",
        " \n",
        "def plot_som_u_matrix(som, cmap='viridis_r'):\n",
        "    from matplotlib.patheffects import withStroke\n",
        "    u_matrix = som.distance_map()\n",
        "    som_x, som_y = som.get_weights().shape[:2]\n",
        "    path_effects = [withStroke(linewidth=3, foreground='black')]\n",
        "    text_colors = np.empty(u_matrix.shape, dtype=object)\n",
        "    mid_point = (np.nanmax(u_matrix) + np.nanmin(u_matrix)) / 2\n",
        "    text_colors[u_matrix < mid_point] = 'white'\n",
        "    text_colors[u_matrix >= mid_point] = 'black'\n",
        "    fig, ax = plt.subplots(figsize=(8, 8))\n",
        "    im = ax.imshow(u_matrix, cmap=cmap)\n",
        "    plt.colorbar(im, ax=ax, label='Distance between neurons')\n",
        "    for i in range(som_x):\n",
        "        for j in range(som_y):\n",
        "            cluster_index = i * som_y + j\n",
        "            ax.text(j, i, str(cluster_index), ha='center', va='center', color=text_colors[i, j], fontweight='bold', path_effects=path_effects)\n",
        "    return fig, ax\n",
        " \n",
        "def plot_cluster_profiles(cube, predictions, band_name, cmap, ax=None, cluster_areas_ha=None):\n",
        "    if ax is None:\n",
        "        fig, ax = plt.subplots(figsize=(12, 6))\n",
        "    else:\n",
        "        fig = ax.get_figure()\n",
        " \n",
        "    da = cube[band_name]\n",
        "    cluster_ids = np.unique(predictions[predictions >= 0])\n",
        "    for cluster_id in cluster_ids:\n",
        "        mean_series = da.where(predictions == cluster_id).mean(dim=['x', 'y'])\n",
        "        label = f'Cluster {cluster_id}'\n",
        "        if cluster_areas_ha and cluster_id in cluster_areas_ha:\n",
        "            label += f' ({cluster_areas_ha[cluster_id]:.2f} ha)'\n",
        "        ax.plot(da['time'].values, mean_series, label=label, color=cmap(cluster_id))\n",
        "    ax.set_xlabel('Time'); ax.set_ylabel(band_name); ax.legend()\n",
        "    ax.set_title('Perfis Médios de NDVI por Cluster')\n",
        "    return fig, ax\n",
        " \n",
        "def plot_cluster_image(predictions, cmap, ax=None, show_colorbar=True):\n",
        "    if ax is None:\n",
        "        fig, ax = plt.subplots(figsize=(8, 6))\n",
        "    else:\n",
        "        fig = ax.get_figure()\n",
        " \n",
        "    masked_preds = np.ma.masked_equal(predictions, -1)\n",
        "    valid_clusters = np.unique(masked_preds.compressed())\n",
        "    if len(valid_clusters) > 0:\n",
        "        min_pred, max_pred = valid_clusters.min(), valid_clusters.max()\n",
        "        n_clusters = max_pred - min_pred + 1\n",
        "        if isinstance(cmap, matplotlib.colors.ListedColormap) and cmap.N < n_clusters:\n",
        "            cmap = matplotlib.colors.ListedColormap(plt.get_cmap('tab20', n_clusters)(range(n_clusters)), name='som_clusters')\n",
        "        else:\n",
        "            cmap = plt.get_cmap(cmap, n_clusters)\n",
        "        bounds = np.arange(min_pred, max_pred + 2) - 0.5\n",
        "        norm = matplotlib.colors.BoundaryNorm(bounds, cmap.N)\n",
        "   \n",
        "    cmap_copy = cmap.copy()\n",
        "    cmap_copy.set_bad(\"white\")\n",
        "    im = ax.imshow(masked_preds, cmap=cmap_copy, norm=norm, interpolation=\"none\")\n",
        "    ax.set_title(\"Mapa de Clusters na Gleba\")\n",
        "    ax.set_axis_off()\n",
        "    if show_colorbar and len(valid_clusters) > 0:\n",
        "        plt.colorbar(im, ax=ax, ticks=np.arange(min_pred, max_pred + 1))\n",
        "    return fig, ax\n",
        "\n",
        "def processar_gleba(\n",
        "        gleba_row, \n",
        "        gleba_id,\n",
        "        map_fig = True,\n",
        "        wtss_fig = True,\n",
        "        sentinel_fig = True,\n",
        "        som_fig = True\n",
        "        ):\n",
        "    \"\"\"\n",
        "    Processa uma única gleba, gerando todas as análises e visualizações.\n",
        "    \"\"\"\n",
        "\n",
        "    # --- Configuração da Iteração Atual ---\n",
        "\n",
        "    # Cria uma cópia para evitar SettingWithCopyWarning\n",
        "    gleba_data = gleba_row.copy()\n",
        "    # Fazer parsing seguro das datas: se o valor for inválido (por ex. 'N/A'),\n",
        "    # usar errors='coerce' para produzir NaT em vez de lançar exceção.\n",
        "    for _date_col in ['DtEms', 'DtVenc', 'DtIniPlant', 'DtFimPlant', 'DtIniColht', 'DtFimColht']:\n",
        "        # gleba_data pode ser uma Series; usar .get para evitar KeyError caso a\n",
        "        # coluna não exista e permitir passagem de None para to_datetime.\n",
        "        try:\n",
        "            gleba_data[_date_col] = pd.to_datetime(gleba_data.get(_date_col), errors='coerce')\n",
        "        except Exception:\n",
        "            # Em caso inesperado, garantir que a coluna exista e contenha NaT\n",
        "            gleba_data[_date_col] = pd.NaT\n",
        "\n",
        "    # Converte a linha atual de volta para um GeoDataFrame\n",
        "    # É importante usar a geometria original da linha passada para a função\n",
        "    glebas_gdf = gpd.GeoDataFrame([gleba_data], geometry='geometry', crs=gdf.crs)\n",
        "\n",
        "    # Extrai as datas de início e fim dinamicamente (se disponíveis)\n",
        "    # Algumas linhas de entrada podem conter NaT se a data for inválida ou ausente.\n",
        "    if pd.notna(gleba_data.get('DtIniPlant')) and pd.notna(gleba_data.get('DtFimColht')):\n",
        "        start_date = gleba_data['DtIniPlant'].strftime('%Y-%m-%d')\n",
        "        end_date = gleba_data['DtFimColht'].strftime('%Y-%m-%d')\n",
        "        dates_available = True\n",
        "    else:\n",
        "        start_date = gleba_data['DtEms'].strftime('%Y-%m-%d')\n",
        "        end_date = (gleba_data['DtEms']+relativedelta(years=1)).strftime('%Y-%m-%d')\n",
        "        dates_available = False\n",
        "\n",
        "\n",
        "    start_date = gleba_data['DtEms'].strftime('%Y-%m-%d')\n",
        "    end_date = (gleba_data['DtEms']+relativedelta(years=1)).strftime('%Y-%m-%d')\n",
        "    dates_available = False\n",
        "\n",
        "    # Se as datas necessárias estiverem ausentes, pular esta etapa para evitar erros\n",
        "    if dates_available and pd.notna(gleba_data.get('DtFimPlant')) and pd.notna(gleba_data.get('DtIniColht')):\n",
        "        # gleba_4326 (geometria) e cubo_modis (objeto wtss) já estão definidos\n",
        "        planting_period = (gleba_data['DtIniPlant'].strftime('%Y-%m-%d'), gleba_data['DtFimPlant'].strftime('%Y-%m-%d'))\n",
        "        harvesting_period = (gleba_data['DtIniColht'].strftime('%Y-%m-%d'), gleba_data['DtFimColht'].strftime('%Y-%m-%d'))\n",
        "    else:\n",
        "        planting_period = None\n",
        "        harvesting_period = None\n",
        "\n",
        "    # Gera um título principal para a seção desta gleba no relatório\n",
        "    print(f\"\\nAnálise para a Gleba ID: {gleba_id}\")\n",
        "    if dates_available:\n",
        "        print(f\"Período de Análise: {start_date} a {end_date}\\n\")\n",
        "    else:\n",
        "        print(f\"Período de Análise: datas de plantio/colheita ausentes ou inválidas.\\n Usando um ano a partir da data de emissão: {start_date} a {end_date}\")\n",
        "\n",
        "    # --- Início da Lógica Original do Relatório ---\n",
        "    # (Todo o seu código de análise vai aqui, sem alterações)\n",
        "\n",
        "    # O ideal é copiar e colar todo o corpo do seu antigo 'for' aqui dentro.\n",
        "    # O código abaixo é apenas um trecho para exemplificar.\n",
        "    # Vou colar todo o seu código original aqui para ficar completo.\n",
        "\n",
        "    # Constantes do script\n",
        "    grid_spacing_meters = 1000\n",
        "    largura_figuras = 18\n",
        "    bdc_stac_link = 'https://data.inpe.br/bdc/stac/v1'\n",
        "    bdc_wtss_link = 'https://data.inpe.br/bdc/wtss/v4/'\n",
        "    bdc_wcpms_url = 'https://data.inpe.br/bdc/wcpms'\n",
        "    colecao_s2 = 'S2-16D-2'\n",
        "    colecao_cbers = 'CBERS4-WFI-16D-2'\n",
        "    colecao_landsat = 'LANDSAT-16D-1'\n",
        "    colecao_modis = 'mod13q1-6.1'\n",
        "\n",
        "    gleba_geo = glebas_gdf\n",
        "    crs_100000 = '+proj=aea +lon_0=-58.1835937 +lat_1=-36.5394082 +lat_2=-3.0767001 +lat_0=-1 9.8080541 +datum=WGS84 +units=m +no_defs'\n",
        "    gleba_4326 = gleba_geo.to_crs('EPSG:4326').iloc[0].geometry.buffer(0)\n",
        "    gleba_100000 = gleba_geo.to_crs(crs_100000).iloc[0]\n",
        "    \n",
        "    print_status(f\"2. Fontes de dados carregadas para a gleba {gleba_id}.\")\n",
        "\n",
        "    if map_fig:\n",
        "        # Carrega apenas o município que cruza com a gleba, economizando memória.\n",
        "        municipio_filtrado = load_ibge_municipalities(bbox=tuple(glebas_gdf.total_bounds))\n",
        "        joined = gpd.sjoin(glebas_gdf, municipio_filtrado, how=\"left\", predicate=\"intersects\")\n",
        "        joined[\"city\"] = joined[\"NM_MUN\"]\n",
        "        joined[\"state\"] = joined[\"NM_UF\"]\n",
        "\n",
        "        fig_localization = plot_rural_property(joined, municipalities_gdf=municipio_filtrado)\n",
        "        plt.show()\n",
        "\n",
        "\n",
        "    if wtss_fig:\n",
        "        # --- NOVO: Etapa 8 - Série Temporal da ÁREA (WTSS Summarize) ---\n",
        "        print_status(\"8. Gerando série temporal média da ÁREA (6 anos, WTSS)...\")\n",
        "\n",
        "        # --- NOVO: Inicialização Centralizada do WTSS ---\n",
        "        # Inicializa o serviço uma vez para ser usado em múltiplos passos\n",
        "\n",
        "        servico_wtss, error = retry_request(\n",
        "            func=wtss.WTSS,\n",
        "            name=\"conecta nos serviços WTSS\",\n",
        "            url=bdc_wtss_link\n",
        "        )\n",
        "\n",
        "        def pega_cubo_modis(servico_wtss, colecao_modis):\n",
        "            return servico_wtss.get(colecao_modis)\n",
        "\n",
        "        cubo_modis, error = retry_request(\n",
        "            func=pega_cubo_modis,\n",
        "            name=\"pega o cubo do modis\",\n",
        "            servico_wtss = servico_wtss,\n",
        "            colecao_modis = colecao_modis\n",
        "        )\n",
        "\n",
        "        #cubo_modis = servico_wtss[colecao_modis]\n",
        "        wtss_ready = True\n",
        "\n",
        "        fig_areal_ts, error = retry_request(\n",
        "            func=get_and_plot_areal_ts_wtss,\n",
        "            name=\"busca da série temporal de ÁREA (WTSS Summarize)\",\n",
        "            cubo=cubo_modis,\n",
        "            gleba_4326=gleba_4326,\n",
        "            gleba_id=gleba_id,\n",
        "            planting_period=planting_period,\n",
        "            harvesting_period=harvesting_period\n",
        "        )\n",
        "        if fig_areal_ts is not None:\n",
        "            plt.show() # Mostra o gráfico gerado pela nova função\n",
        "\n",
        "\n",
        "    if sentinel_fig:\n",
        "        # Renumbered to Etapa 6\n",
        "        def search_stac_items(stac_link, collection, start_date, end_date, bbox):\n",
        "            catalog = pystac_client.Client.open(stac_link)\n",
        "            search = catalog.search(collections=[collection], datetime=f'{start_date}/{end_date}', bbox=bbox)\n",
        "            return sorted(list(search.get_all_items()), key=lambda a: a.datetime, reverse=False)\n",
        "\n",
        "        print_status(\"6. Buscando e processando imagens Sentinel-2...\")\n",
        "        time_ordered_items, error = retry_request(\n",
        "            func=search_stac_items,\n",
        "            name=\"busca de itens Sentinel-2 no catálogo STAC\",\n",
        "            stac_link=bdc_stac_link,\n",
        "            collection=colecao_s2,\n",
        "            start_date=start_date,\n",
        "            end_date=end_date,\n",
        "            bbox=gleba_4326.bounds\n",
        "        )\n",
        "\n",
        "        if error:\n",
        "            print(f'Não foi possível buscar a lista de imagens de satélite do catálogo STAC do INPE. Toda a análise de imagens (recortes, RGB, EVI) foi pulada. Erro: {error}')\n",
        "            time_ordered_items = []\n",
        "\n",
        "        # Renumbered to Etapa 7\n",
        "        total_rasters = len(time_ordered_items)\n",
        "\n",
        "        print_status(\"7. Gerando composições RGB e EVI...\")\n",
        "        if total_rasters > 0:\n",
        "            merged_assets = merge_assets_by_date(time_ordered_items, gleba_geo)\n",
        "            \n",
        "            # Convert dictionary to list to allow slicing\n",
        "            asset_list = list(merged_assets.items())\n",
        "            \n",
        "            batch_size = 3\n",
        "            ncols = 2  # RGB | EVI\n",
        "            cm = plt.get_cmap('turbo')\n",
        "\n",
        "            # Iterate through the assets in chunks of 3\n",
        "            for start_idx in range(0, len(asset_list), batch_size):\n",
        "                # Get the current batch of 3 (or fewer for the last page)\n",
        "                batch = asset_list[start_idx : start_idx + batch_size]\n",
        "                nrows = len(batch)\n",
        "                \n",
        "                # Create a new figure for this page\n",
        "                # Adjusted height (4 * nrows) to ensure images aren't too squashed\n",
        "                fig, axes = plt.subplots(nrows=nrows, ncols=ncols, figsize=(10, 4 * nrows), squeeze=False)\n",
        "                \n",
        "                for i, (date, assets) in enumerate(batch):\n",
        "                    ax_rgb = axes[i, 0]\n",
        "                    ax_evi = axes[i, 1]\n",
        "\n",
        "                    # RGB (left)\n",
        "                    if assets.get('rgb') is not None:\n",
        "                        ax_rgb.imshow(np.clip(assets['rgb'] / 1.5, 0, 1))\n",
        "                        ax_rgb.set_title(f\"{date} (RGB)\")\n",
        "                    else:\n",
        "                        ax_rgb.text(0.5, 0.5, 'RGB Erro', ha='center', va='center')\n",
        "                        ax_rgb.set_title(f\"{date} (RGB)\")\n",
        "                    ax_rgb.set_xticks([])\n",
        "                    ax_rgb.set_yticks([])\n",
        "\n",
        "                    # EVI (right) with colorbar\n",
        "                    if assets.get('evi') is not None:\n",
        "                        im = ax_evi.imshow(assets['evi'], cmap=cm, vmin=0, vmax=1)\n",
        "                        ax_evi.set_title(f\"{date} (EVI)\")\n",
        "                        cax = fig.colorbar(im, ax=ax_evi, fraction=0.046, pad=0.04)\n",
        "                        cax.set_label('EVI')\n",
        "                    else:\n",
        "                        ax_evi.text(0.5, 0.5, 'EVI Erro', ha='center', va='center')\n",
        "                        ax_evi.set_title(f\"{date} (EVI)\")\n",
        "                    ax_evi.set_xticks([])\n",
        "                    ax_evi.set_yticks([])\n",
        "\n",
        "                plt.tight_layout()\n",
        "                plt.show()\n",
        "                \n",
        "                # Force a page break after every plot group\n",
        "                display(Markdown(r\"\\newpage\"))\n",
        "\n",
        "    if som_fig:\n",
        "        print_status(\"9. Criando cubo de dados para clusterização SOM...\") # Renumbered\n",
        "\n",
        "        cubo, mask, error = None, None, None\n",
        "        try:\n",
        "            if total_rasters > 0 and start_date is not None and end_date is not None: # Only try if we found images and dates are available\n",
        "                cubo, mask = process_cube(shapefile=gleba_geo, query_bands=['NDVI', 'SCL'], start_date=start_date, end_date=end_date, collections=[colecao_s2], stac_url=bdc_stac_link, resolution=10)\n",
        "            else:\n",
        "                # Don't set an error, just acknowledge there's nothing to process\n",
        "                if total_rasters == 0:\n",
        "                    print_status(\"   - AVISO: Nenhuma imagem encontrada no passo anterior. Análise SOM pulada.\")\n",
        "                else:\n",
        "                    print_status(\"   - AVISO: Datas ausentes — processamento do cubo para SOM pulado.\")\n",
        "        except Exception as e:\n",
        "            error = e\n",
        "            print_status(f\"ERRO: Falha ao processar o cubo de dados para SOM: {e}\")\n",
        "\n",
        "        if error or cubo is None:\n",
        "            # Only print error message if there was an actual error\n",
        "            if error: # This condition is redundant with the outer if, but keeping it as per original structure\n",
        "                print(f'Não foi possível gerar o cubo de dados do serviço do INPE necessário para a análise SOM. Esta seção foi pulada. Erro: {error}')\n",
        "\n",
        "        elif 'time' in cubo.dims and len(cubo.time) > 1:\n",
        "            sqrt_n = 3\n",
        "            print_status(\"10. Executando clusterização SOM...\")\n",
        "            result, neuron_weights, predictions, som = som_time_series_clustering(cubo, mask, n=sqrt_n, random_seed=123, training_steps=100)\n",
        "            num_clusters = sqrt_n * sqrt_n\n",
        "            base_cmap = plt.get_cmap('tab20', num_clusters)\n",
        "            color_list = [base_cmap(i) for i in range(num_clusters)]\n",
        "            cmap = matplotlib.colors.ListedColormap(color_list, name='som_clusters')\n",
        "            \n",
        "            # Calculate cluster areas\n",
        "            brazil_aea_proj = \"+proj=aea +lat_0=-12 +lon_0=-54 +lat_1=-2 +lat_2=-22 +x_0=5000000 +y_0=10000000 +ellps=GRS80 +units=m +no_defs\"\n",
        "            gleba_aea = gleba_geo.to_crs(brazil_aea_proj)\n",
        "            total_area_ha = gleba_aea.geometry.area.iloc[0] / 10000\n",
        "            \n",
        "            cluster_ids, pixel_counts = np.unique(predictions[predictions >= 0], return_counts=True)\n",
        "            total_pixels = np.sum(pixel_counts)\n",
        "            \n",
        "            cluster_areas_ha = {}\n",
        "            if total_pixels > 0:\n",
        "                for cluster_id, count in zip(cluster_ids, pixel_counts):\n",
        "                    percentage = (count / total_pixels)\n",
        "                    area_ha = percentage * total_area_ha\n",
        "                    cluster_areas_ha[cluster_id] = area_ha\n",
        "\n",
        "            fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(18, 6), gridspec_kw={'width_ratios': [4, 3]})\n",
        "            plot_cluster_profiles(cubo, predictions, band_name='NDVI', cmap=cmap, ax=ax1, cluster_areas_ha=cluster_areas_ha)\n",
        "            plot_cluster_image(predictions, cmap, ax=ax2, show_colorbar=False)\n",
        "            fig.suptitle('Análise de Clusters SOM', fontsize=16)\n",
        "            plt.tight_layout(rect=[0, 0.03, 1, 0.95])\n",
        "            plt.show()\n",
        "\n",
        "        else:\n",
        "            print_status(\"   - AVISO: Não há dados suficientes no cubo para a análise SOM. A análise foi pulada.\")\n"
      ],
      "id": "391e26b2",
      "execution_count": null,
      "outputs": []
    },
